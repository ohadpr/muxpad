#!/usr/bin/env bash
# muxpad — minimal background daemon control for a personal install.
#
#   muxpad start      build (if needed) and run the daemon in the background
#   muxpad stop       SIGTERM the daemon
#   muxpad restart    stop + start
#   muxpad status     show running state, URL, log path
#   muxpad logs       tail the log
#
# Survives terminal close. Does NOT auto-restart on crash or auto-start on
# reboot — for that, install the launchd plist in the README.
#
# Tailscale IP is auto-detected. Override with MUXPAD_HOST.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DATA_DIR="${MUXPAD_DATA_DIR:-$HOME/.muxpad}"
PID_FILE="$DATA_DIR/server.pid"
LOG_FILE="$DATA_DIR/server.log"
PID_FILE_PTYD="$DATA_DIR/ptyd.pid"
LOG_FILE_PTYD="$DATA_DIR/ptyd.log"
# Socket path must match server/src/config.ts default so the main server
# and ptyd agree without us having to pass MUXPAD_PTYD_SOCKET to the server.
PTYD_SOCKET="${MUXPAD_PTYD_SOCKET:-$DATA_DIR/ptyd.sock}"

mkdir -p "$DATA_DIR"

# ─── launchd awareness ───────────────────────────────────────────────────────
# When the daemons run as launchd jobs (docs/launchd.md), launchd owns the
# processes and there are no pid files. A pid-file-only check then reports
# "not running" for a daemon that has been up for days — and `start` happily
# spawns a SECOND one to fight over :7777 and the ptyd socket. Ask launchctl
# first, and route stop/restart through it so we never race KeepAlive (which
# would just resurrect whatever we killed).
LAUNCHD_MAIN="dev.muxpad"
LAUNCHD_PTYD="dev.muxpad.ptyd"

launchd_loaded() {
  launchctl print "gui/$UID/$1" >/dev/null 2>&1
}

# Echo the job's pid; empty when the job isn't loaded or isn't running.
launchd_pid() {
  launchctl print "gui/$UID/$1" 2>/dev/null |
    awk -F'= ' '/^[[:space:]]*pid = /{gsub(/[^0-9]/, "", $2); print $2; exit}'
}

is_running() {
  [ -n "$(launchd_pid "$LAUNCHD_MAIN")" ] && return 0
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

is_ptyd_running() {
  [ -n "$(launchd_pid "$LAUNCHD_PTYD")" ] && return 0
  [ -f "$PID_FILE_PTYD" ] && kill -0 "$(cat "$PID_FILE_PTYD")" 2>/dev/null
}

# Which pid to show/signal for a daemon: launchd's if it owns it, else ours.
running_pid() {
  local label="$1" pid_file="$2" pid
  pid="$(launchd_pid "$label")"
  if [ -n "$pid" ]; then
    echo "$pid"
    return
  fi
  [ -f "$pid_file" ] && cat "$pid_file"
}

# Send SIGTERM, wait, escalate to SIGKILL. Removes the pid file at the end.
stop_pid_file() {
  local label="$1" pid_file="$2"
  if [ ! -f "$pid_file" ]; then
    echo "$label: not running"
    return
  fi
  local pid
  pid="$(cat "$pid_file")"
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "$label: not running (stale pid file)"
    rm -f "$pid_file"
    return
  fi
  echo "$label: stopping PID $pid..."
  kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    if ! kill -0 "$pid" 2>/dev/null; then break; fi
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "$label: still alive, sending SIGKILL"
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file"
  echo "$label: stopped"
}

# Spawn a daemon in its own session, append its output to a log, and echo
# its pid.
#
# `nohup cmd & disown` is NOT enough. It only protects against SIGHUP when a
# terminal closes — the daemon stays in the *caller's* process group. Agent
# CLIs and IDE shells (Cursor, Claude Code, VS Code tasks) routinely reap
# their shell's whole process group with SIGKILL when a tool call or session
# ends, which takes the daemon with it. That kill can't be caught, so the
# server dies with no "shutting down…" in the log and nothing restarts it
# (there's no supervisor by design). Setting detached:true makes node call
# setsid(2) in the child, so it lands in a fresh session that no group-kill
# aimed at the caller can reach. `muxpad stop` is unaffected — it signals the
# pid from the pid file directly.
spawn_detached() {
  local log="$1"
  shift
  node -e '
const { spawn } = require("node:child_process");
const fs = require("node:fs");
const [log, ...cmd] = process.argv.slice(1);
const out = fs.openSync(log, "a");
const child = spawn(cmd[0], cmd.slice(1), {
  detached: true,
  stdio: ["ignore", out, out],
});
// A failed exec (bad path) fires async error and leaves pid undefined; log it
// and exit nonzero WITHOUT printing a pid, so the caller never writes a bogus
// "undefined" into the pid file.
child.on("error", (e) => {
  try { fs.writeSync(out, `spawn_detached failed: ${e.message}\n`); } catch {}
  process.exit(1);
});
if (typeof child.pid !== "number") process.exit(1);
child.unref();
process.stdout.write(`${child.pid}\n`);
' "$log" "$@"
}

resolve_host() {
  if [ -n "${MUXPAD_HOST:-}" ]; then
    echo "$MUXPAD_HOST"
    return
  fi
  if command -v tailscale >/dev/null 2>&1; then
    local ip
    ip="$(tailscale ip -4 2>/dev/null | head -1 || true)"
    if [ -n "$ip" ]; then
      echo "$ip"
      return
    fi
  fi
  echo "0.0.0.0"
}

cmd_start() {
  if is_running; then
    echo "already running (PID $(running_pid "$LAUNCHD_MAIN" "$PID_FILE"))"
    cmd_status
    return
  fi

  # Loaded-but-stopped launchd jobs: hand the start back to launchd instead of
  # spawning a rival copy it doesn't supervise.
  if launchd_loaded "$LAUNCHD_MAIN"; then
    echo "launchd-managed — kickstarting the jobs"
    launchd_loaded "$LAUNCHD_PTYD" && launchctl kickstart "gui/$UID/$LAUNCHD_PTYD" >/dev/null 2>&1 || true
    launchctl kickstart "gui/$UID/$LAUNCHD_MAIN" >/dev/null 2>&1 || true
    sleep 0.6
    cmd_status
    return
  fi

  if [ ! -f "$ROOT/shared/dist/index.js" ] \
    || [ ! -f "$ROOT/server/dist/index.js" ] \
    || [ ! -f "$ROOT/server/dist/ptyd/index.js" ] \
    || [ ! -f "$ROOT/web/dist/index.html" ]; then
    echo "building..."
    # dist is missing/incomplete, but the tsc -b build cache (*.tsbuildinfo)
    # may have survived (manual cleanup, editor action, partial sync). tsc
    # trusts that cache, believes it's already built, and skips emitting — so
    # dist stays incomplete and the server later dies with a baffling
    # "Cannot find module '@muxpad/shared'" that looks like a code bug. Drop
    # the cache here so the build regenerates dist from scratch, in lockstep.
    rm -f "$ROOT/shared/tsconfig.tsbuildinfo" "$ROOT/server/tsconfig.tsbuildinfo"
    # Capture build output; on failure print the tail so the real tsc error is
    # visible instead of a bare "ELIFECYCLE Command failed" with no context.
    if ! (cd "$ROOT" && pnpm build) > "$LOG_FILE.build" 2>&1; then
      echo "build failed — last 50 lines of $LOG_FILE.build:" >&2
      tail -50 "$LOG_FILE.build" >&2
      exit 1
    fi
  fi

  local host port
  host="$(resolve_host)"
  port="${MUXPAD_PORT:-7777}"

  # When MUXPAD_TAILSCALE_SERVE=1, force the daemon to bind localhost so
  # the only public face is via tailscale serve (port 443 with cert).
  # Otherwise bind whatever resolve_host picked.
  if [ "${MUXPAD_TAILSCALE_SERVE:-0}" = "1" ]; then
    host="127.0.0.1"
  fi

  # Start ptyd first (if not already up). The main server connects to its
  # socket on startup, so we must wait for the socket to appear before
  # spawning the server. ptyd needs MUXPAD_HOST/MUXPAD_PORT too — it's the
  # one that actually spawns pane shells (PaneRuntime lives in ptyd), and
  # sets each shell's MUXPAD_API_URL from those vars. Without them here,
  # panes fall back to the localhost default and can't reach a daemon
  # bound to a non-loopback host (e.g. Tailscale) — restarting ptyd alone
  # never fixes it since the vars were never in its env to begin with.
  if ! is_ptyd_running; then
    start_ptyd "$host" "$port"
  else
    echo "ptyd: already running (PID $(cat "$PID_FILE_PTYD"))"
  fi

  echo "starting on http://$host:$port"
  spawn_detached "$LOG_FILE" env \
    MUXPAD_HOST="$host" \
    MUXPAD_PORT="$port" \
    MUXPAD_DATA_DIR="$DATA_DIR" \
    MUXPAD_PTYD_SOCKET="$PTYD_SOCKET" \
    node "$ROOT/server/dist/index.js" \
    > "$PID_FILE"
  sleep 0.4

  if [ "${MUXPAD_TAILSCALE_SERVE:-0}" = "1" ]; then
    setup_tailscale_serve "$port"
  fi

  cmd_status
}

start_ptyd() {
  local host="$1" port="$2"
  mkdir -p "$(dirname "$PTYD_SOCKET")"
  # Stale socket file from a crashed previous run will block bind().
  # Remove it only when we know no ptyd is currently using it.
  [ -S "$PTYD_SOCKET" ] && rm -f "$PTYD_SOCKET"
  echo "starting ptyd (socket: $PTYD_SOCKET)"
  spawn_detached "$LOG_FILE_PTYD" env \
    MUXPAD_HOST="$host" \
    MUXPAD_PORT="$port" \
    MUXPAD_DATA_DIR="$DATA_DIR" \
    MUXPAD_PTYD_SOCKET="$PTYD_SOCKET" \
    node "$ROOT/server/dist/ptyd/index.js" \
    > "$PID_FILE_PTYD"
  # Wait for the socket to appear (up to ~5s).
  local i
  for i in $(seq 1 50); do
    if [ -S "$PTYD_SOCKET" ]; then
      return 0
    fi
    # If ptyd died on us mid-wait, bail early with a clear message.
    if ! is_ptyd_running; then
      echo "ptyd: exited before socket appeared — see $LOG_FILE_PTYD" >&2
      rm -f "$PID_FILE_PTYD"
      exit 1
    fi
    sleep 0.1
  done
  echo "ptyd: timed out waiting for socket at $PTYD_SOCKET" >&2
  exit 1
}

setup_tailscale_serve() {
  local port="$1"
  if ! command -v tailscale >/dev/null 2>&1; then
    echo "warning: MUXPAD_TAILSCALE_SERVE=1 but tailscale CLI not found; skipping"
    return
  fi
  echo "configuring tailscale serve → localhost:$port"
  if ! tailscale serve --bg "https://localhost:$port" >/dev/null; then
    echo "warning: tailscale serve setup failed"
    return
  fi
  # Print the resulting public URL so the user sees it next to the local one.
  local fqdn
  fqdn="$(tailscale status --json 2>/dev/null | grep -oE '"DNSName":[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"([^"]+)\.?"/\1/' | sed 's/\.$//')"
  if [ -n "$fqdn" ]; then
    echo "  public: https://$fqdn/"
  fi
}

teardown_tailscale_serve() {
  if ! command -v tailscale >/dev/null 2>&1; then return; fi
  # Only tear down if our mapping is present, to avoid clobbering other
  # services the user may have mapped via tailscale serve.
  local port="${MUXPAD_PORT:-7777}"
  if tailscale serve status 2>/dev/null | grep -q "localhost:$port"; then
    echo "removing tailscale serve mapping"
    tailscale serve --bg --https=443 off >/dev/null 2>&1 || true
  fi
}

cmd_stop() {
  # The first arg may be --all (passed by the dispatcher). Anything else
  # is unknown.
  local stop_all=0
  for a in "$@"; do
    case "$a" in
      --all) stop_all=1 ;;
      *) echo "muxpad stop: unknown flag '$a'" >&2; exit 1 ;;
    esac
  done

  # Only teardown tailscale on a full stop. A plain `muxpad stop` (and
  # therefore the default `muxpad restart`) leaves the public mapping in
  # place so tailnet users don't see a 4xx blip during routine restarts.
  # When the user really means it (`--all`), the mapping comes down with
  # the daemons.
  if [ "$stop_all" = "1" ]; then
    teardown_tailscale_serve
  fi

  # Under launchd, KeepAlive respawns anything we SIGTERM — a plain kill would
  # look like it worked and the daemon would be back a second later. Booting
  # the job out is the real stop; it stays down until `muxpad start` (kickstart
  # via the bootstrap below) or the next login.
  if launchd_loaded "$LAUNCHD_MAIN"; then
    echo "muxpad: launchd job $LAUNCHD_MAIN — booting out"
    launchctl bootout "gui/$UID/$LAUNCHD_MAIN" 2>/dev/null || true
    if [ "$stop_all" = "1" ] && launchd_loaded "$LAUNCHD_PTYD"; then
      echo "ptyd: launchd job $LAUNCHD_PTYD — booting out (this kills every pane)"
      launchctl bootout "gui/$UID/$LAUNCHD_PTYD" 2>/dev/null || true
      [ -S "$PTYD_SOCKET" ] && rm -f "$PTYD_SOCKET"
    elif is_ptyd_running; then
      echo "ptyd: still running (PID $(running_pid "$LAUNCHD_PTYD" "$PID_FILE_PTYD")) — use 'muxpad stop --all' to stop it too"
    fi
    echo "note: both jobs come back at next login (RunAtLoad); re-arm now with 'muxpad start'"
    return
  fi

  stop_pid_file "muxpad" "$PID_FILE"

  if [ "$stop_all" = "1" ]; then
    stop_pid_file "ptyd" "$PID_FILE_PTYD"
    # Clean up the socket file once nobody is using it.
    [ -S "$PTYD_SOCKET" ] && rm -f "$PTYD_SOCKET"
  else
    if is_ptyd_running; then
      echo "ptyd: still running (PID $(running_pid "$LAUNCHD_PTYD" "$PID_FILE_PTYD")) — use 'muxpad stop --all' to stop it too"
    fi
  fi
}

cmd_restart() {
  local restart_all=0
  for a in "$@"; do
    case "$a" in
      --all) restart_all=1 ;;
      *) echo "muxpad restart: unknown flag '$a'" >&2; exit 1 ;;
    esac
  done

  # launchd restarts a job in place (`kickstart -k`) without ever leaving it
  # stopped, so there's no window for KeepAlive to race a manual start. Same
  # rule as by hand: main only, unless --all — bouncing ptyd kills every pane.
  if launchd_loaded "$LAUNCHD_MAIN"; then
    if [ "$restart_all" = "1" ] && launchd_loaded "$LAUNCHD_PTYD"; then
      echo "restarting $LAUNCHD_PTYD (kills every pane)"
      launchctl kickstart -k "gui/$UID/$LAUNCHD_PTYD" >/dev/null
    fi
    echo "restarting $LAUNCHD_MAIN"
    launchctl kickstart -k "gui/$UID/$LAUNCHD_MAIN" >/dev/null
    sleep 0.6
    cmd_status
    return
  fi

  if [ "$restart_all" = "1" ]; then
    cmd_stop --all || true
  else
    cmd_stop || true
  fi
  sleep 0.3
  cmd_start
}

cmd_status() {
  # muxpad
  if is_running; then
    local pid url
    pid="$(running_pid "$LAUNCHD_MAIN" "$PID_FILE")"
    url="$(grep -oE 'http://[^[:space:]]+' "$LOG_FILE" 2>/dev/null | tail -1 || true)"
    echo "muxpad:"
    echo "  running (PID $pid)"
    launchd_loaded "$LAUNCHD_MAIN" && echo "  owner: launchd ($LAUNCHD_MAIN, KeepAlive)"
    [ -n "$url" ] && echo "  url:  $url"
    echo "  log:  $LOG_FILE"
    echo "  data: $DATA_DIR"
  else
    echo "muxpad: not running"
  fi

  # ptyd
  if is_ptyd_running; then
    local pid
    pid="$(running_pid "$LAUNCHD_PTYD" "$PID_FILE_PTYD")"
    echo "ptyd:"
    echo "  running (PID $pid)"
    launchd_loaded "$LAUNCHD_PTYD" && echo "  owner:  launchd ($LAUNCHD_PTYD, KeepAlive)"
    echo "  socket: $PTYD_SOCKET"
    echo "  log:    $LOG_FILE_PTYD"
  else
    echo "ptyd: not running"
  fi
}

cmd_logs() {
  local target="server"
  for a in "$@"; do
    case "$a" in
      --ptyd) target="ptyd" ;;
      --all) target="all" ;;
      *) echo "muxpad logs: unknown flag '$a'" >&2; exit 1 ;;
    esac
  done

  case "$target" in
    server)
      if [ ! -f "$LOG_FILE" ]; then
        echo "no log yet at $LOG_FILE"
        exit 1
      fi
      exec tail -f "$LOG_FILE"
      ;;
    ptyd)
      if [ ! -f "$LOG_FILE_PTYD" ]; then
        echo "no log yet at $LOG_FILE_PTYD"
        exit 1
      fi
      exec tail -f "$LOG_FILE_PTYD"
      ;;
    all)
      # tail -f labels each stream with its filename on macOS, so the
      # streams stay legible when interleaved.
      local files=()
      [ -f "$LOG_FILE" ] && files+=("$LOG_FILE")
      [ -f "$LOG_FILE_PTYD" ] && files+=("$LOG_FILE_PTYD")
      if [ "${#files[@]}" = "0" ]; then
        echo "no logs yet"
        exit 1
      fi
      exec tail -f "${files[@]}"
      ;;
  esac
}

# ─── In-pane CLI verbs (HTTP) ────────────────────────────────────────────────
# These speak HTTP to the daemon. Inside a muxpad pane, the daemon is
# already running and these env vars are injected by PaneRuntime:
#   MUXPAD_API_URL          http://localhost:<port>
#   MUXPAD_PANE_ID          current pane id
#   MUXPAD_TAB_ID           current tab id
#   MUXPAD_WORKSPACE_ID     current workspace id
# Outside a pane, set MUXPAD_API_URL manually (e.g. via the daemon's
# config); --tab / --workspace flags then become required for ops that
# would otherwise default to the in-pane context.

# Top-level --json flag — set by parse_global_flags. When 1, all output
# helpers dump raw server JSON instead of pretty-formatting.
JSON_OUTPUT=0

# ANSI colors, only when stdout is a TTY. Plumbing-friendly otherwise.
if [ -t 1 ]; then
  C_GREEN=$'\033[32m'
  C_RED=$'\033[31m'
  C_DIM=$'\033[2m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
else
  C_GREEN=''
  C_RED=''
  C_DIM=''
  C_BOLD=''
  C_RESET=''
fi

require_jq() {
  command -v jq >/dev/null 2>&1 || {
    echo "muxpad: jq is required (brew install jq)" >&2
    exit 1
  }
}

require_api_url() {
  if [ -z "${MUXPAD_API_URL:-}" ]; then
    echo "muxpad: MUXPAD_API_URL not set (are you inside a muxpad pane?)" >&2
    exit 1
  fi
}

# Run a curl request against the daemon. Args:
#   $1 method (GET/POST/DELETE)
#   $2 path (e.g. /api/workspaces)
#   $3 optional JSON body (only for POST)
# Captures the response body and HTTP status. On non-2xx, prints the
# server's error JSON (or raw body) to stderr and exits non-zero.
http_request() {
  require_api_url
  local method="$1"
  local path="$2"
  local body="${3:-}"
  local url="${MUXPAD_API_URL%/}$path"
  local tmp
  tmp="$(mktemp)"
  local status
  if [ -n "$body" ]; then
    status="$(curl -sS -o "$tmp" -w '%{http_code}' \
      -X "$method" \
      -H 'content-type: application/json' \
      --data "$body" \
      "$url")"
  else
    status="$(curl -sS -o "$tmp" -w '%{http_code}' \
      -X "$method" \
      "$url")"
  fi
  if [ "$status" -lt 200 ] || [ "$status" -ge 300 ]; then
    {
      printf '%smuxpad: %s %s → HTTP %s%s\n' "$C_RED" "$method" "$path" "$status" "$C_RESET"
      if [ -s "$tmp" ]; then
        # Try to surface the server's error.message; fall back to raw body.
        if jq -e '.error.message' "$tmp" >/dev/null 2>&1; then
          printf '  %s\n' "$(jq -r '.error.message' "$tmp")"
        else
          cat "$tmp"
          printf '\n'
        fi
      fi
    } >&2
    rm -f "$tmp"
    exit 1
  fi
  cat "$tmp"
  rm -f "$tmp"
}

# Pretty-print a freshly created resource. $1 = type label, $2 = JSON.
# Honors JSON_OUTPUT. The "extra" lines (id, name, tab, etc.) are
# selected per resource type — kept inline-cased for clarity over DRY.
print_created() {
  local label="$1"
  local json="$2"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$json"
    return
  fi
  printf '%s✓%s %s created\n' "$C_GREEN" "$C_RESET" "$label"
  case "$label" in
    workspace)
      printf '  %sid:%s   %s\n' "$C_DIM" "$C_RESET" "$(printf '%s' "$json" | jq -r '.id')"
      printf '  %sname:%s %s\n' "$C_DIM" "$C_RESET" "$(printf '%s' "$json" | jq -r '.name')"
      ;;
    tab)
      printf '  %sid:%s        %s\n' "$C_DIM" "$C_RESET" "$(printf '%s' "$json" | jq -r '.id')"
      printf '  %sname:%s      %s\n' "$C_DIM" "$C_RESET" "$(printf '%s' "$json" | jq -r '.name')"
      ;;
    pane)
      local kind url tab
      kind="$(printf '%s' "$json" | jq -r '.kind')"
      url="$(printf '%s' "$json" | jq -r '.url // empty')"
      tab="$(printf '%s' "$json" | jq -r '.tab_id')"
      printf '  %sid:%s   %s\n' "$C_DIM" "$C_RESET" "$(printf '%s' "$json" | jq -r '.id')"
      printf '  %skind:%s %s\n' "$C_DIM" "$C_RESET" "$kind"
      [ -n "$url" ] && printf '  %surl:%s  %s\n' "$C_DIM" "$C_RESET" "$url"
      printf '  %stab:%s  %s\n' "$C_DIM" "$C_RESET" "$tab"
      ;;
  esac
}

# Print a JSON array as a table. $1 = JSON array, remaining = column
# specs of the form "HEADER:jq-expr". Columns are space-padded to the
# widest cell. Honors JSON_OUTPUT (dumps the raw array).
print_table() {
  local json="$1"; shift
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$json"
    return
  fi
  if [ "$(printf '%s' "$json" | jq 'length')" = "0" ]; then
    printf '%s(none)%s\n' "$C_DIM" "$C_RESET"
    return
  fi
  # Build a row-per-line representation via jq. Each column is rendered
  # by its jq expr, joined with a tab. Headers go first.
  local header_line=''
  local exprs=()
  for col in "$@"; do
    local h="${col%%:*}"
    local e="${col#*:}"
    [ -n "$header_line" ] && header_line+=$'\t'
    header_line+="$h"
    exprs+=("$e")
  done
  # Compose a jq filter: [ (.[0] | [(<expr1>), (<expr2>), …] | @tsv), … ]
  local jq_parts=''
  for e in "${exprs[@]}"; do
    [ -n "$jq_parts" ] && jq_parts+=','
    jq_parts+="($e)"
  done
  local rows
  rows="$(printf '%s' "$json" | jq -r ".[] | [$jq_parts] | @tsv")"
  # Pad columns using awk so headers + rows line up.
  {
    printf '%s\n' "$header_line"
    printf '%s\n' "$rows"
  } | awk -F '\t' -v bold="$C_BOLD" -v reset="$C_RESET" '
    {
      for (i = 1; i <= NF; i++) {
        # Carriage returns and tabs cannot survive into a cell: this output is
        # routinely parsed by a supervisor (and by an agent) with cut/awk, and
        # a control character inside a pane id is a malformed URL and a curl
        # that returns 000 with no explanation. jq @tsv escapes them in the
        # DATA, but a value that arrives already containing one would not be.
        gsub(/[\r\t]/, "", $i);
        if (length($i) > w[i]) w[i] = length($i);
        cell[NR, i] = $i;
      }
      ncols = NF;
      nrows = NR;
    }
    END {
      for (r = 1; r <= nrows; r++) {
        line = "";
        for (i = 1; i <= ncols; i++) {
          v = cell[r, i];
          # Pad only BETWEEN columns. Padding the last one too put trailing
          # whitespace on every row of every table muxpad prints — invisible
          # on screen, and one more thing a caller has to strip off an id.
          if (i < ncols) {
            pad = w[i] - length(v);
            if (pad < 0) pad = 0;
            line = line v sprintf("%*s", pad, "") "  ";
          } else {
            line = line v;
          }
        }
        if (r == 1) printf "%s%s%s\n", bold, line, reset;
        else printf "%s\n", line;
      }
    }
  '
}

# Parse argv looking for the top-level --json flag. Sets JSON_OUTPUT
# directly (no subshell — must run in the current shell to mutate the
# global) and populates the global ARGS array with the remaining args.
# Called as: strip_global_flags "$@".
strip_global_flags() {
  ARGS=()
  for a in "$@"; do
    case "$a" in
      --json) JSON_OUTPUT=1 ;;
      *) ARGS+=("$a") ;;
    esac
  done
}

# Parse --key=value / --key value pairs from positional args. macOS's
# bash 3.2 has no associative arrays, so we set plain scalar globals
# named FLAG_<key> for each allowed flag. Callers `unset` them before
# the call to start clean. Usage:
#   reset_flags name workspace tab cmd cwd
#   parse_flags name workspace tab cmd cwd -- "$@"
#   # now $FLAG_name, $FLAG_workspace, … (empty if not provided)
#   # and POSITIONAL=(non-flag args in order)
# Unknown flags error out.
reset_flags() {
  for f in "$@"; do
    unset "FLAG_$f"
    eval "FLAG_$f=''"
  done
  POSITIONAL=()
}

parse_flags() {
  local allowed=()
  while [ $# -gt 0 ] && [ "$1" != '--' ]; do
    allowed+=("$1")
    shift
  done
  shift  # drop the --
  while [ $# -gt 0 ]; do
    local a="$1"
    case "$a" in
      --)
        # End of flags (`muxpad serve --url … -- <command…>`): everything
        # after the bare -- is positional, verbatim — flags belonging to the
        # wrapped command must not be parsed as ours.
        shift
        while [ $# -gt 0 ]; do
          POSITIONAL+=("$1")
          shift
        done
        break
        ;;
      --*=*)
        local k="${a%%=*}"; k="${k#--}"
        local v="${a#*=}"
        local ok=0
        for x in "${allowed[@]:-}"; do [ "$x" = "$k" ] && ok=1; done
        if [ $ok = 0 ]; then
          echo "muxpad: unknown flag --$k" >&2
          exit 1
        fi
        # eval is safe here: $k is gated by the allow-list above, $v is
        # quoted via printf %q to neutralise any metacharacters in the
        # user-supplied value.
        eval "FLAG_$k=$(printf '%q' "$v")"
        shift
        ;;
      --*)
        local k="${a#--}"
        local ok=0
        for x in "${allowed[@]:-}"; do [ "$x" = "$k" ] && ok=1; done
        if [ $ok = 0 ]; then
          echo "muxpad: unknown flag --$k" >&2
          exit 1
        fi
        if [ $# -lt 2 ]; then
          echo "muxpad: --$k requires a value" >&2
          exit 1
        fi
        eval "FLAG_$k=$(printf '%q' "$2")"
        shift 2
        ;;
      *)
        POSITIONAL+=("$a")
        shift
        ;;
    esac
  done
}

# JSON-escape a string for embedding in a request body. Uses jq -Rs so
# all the quoting edge cases (quotes, backslashes, newlines) are right.
json_string() {
  printf '%s' "$1" | jq -Rs .
}

# ─── workspace ─────────────────────────────────────────────────────────────

cmd_workspace_new() {
  reset_flags name
  parse_flags name -- "$@"
  local body='{}'
  if [ -n "${FLAG_name:-}" ]; then
    body="{\"name\":$(json_string "$FLAG_name")}"
  fi
  local res
  res="$(http_request POST /api/workspaces "$body")"
  print_created workspace "$res"
}

cmd_workspace_list() {
  local res
  res="$(http_request GET /api/workspaces)"
  print_table "$res" \
    'ID:.id' \
    'STATUS:(.status // "idle")' \
    'AGENTS:(.agents // 0)' \
    'TABS:.tab_count' \
    'NAME:.name'
}

cmd_workspace_delete() {
  reset_flags
  parse_flags -- "$@"
  if [ "${#POSITIONAL[@]}" -lt 1 ]; then
    echo "usage: muxpad workspace delete <id>" >&2
    exit 1
  fi
  local id="${POSITIONAL[0]}"
  http_request DELETE "/api/workspaces/$id" >/dev/null
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '{"deleted":"%s"}\n' "$id"
  else
    printf '%s✓%s workspace deleted (%s)\n' "$C_GREEN" "$C_RESET" "$id"
  fi
}

cmd_workspace() {
  local verb="${1:-}"
  if [ -z "$verb" ]; then
    echo "usage: muxpad workspace {new|list|delete}" >&2
    exit 1
  fi
  shift
  case "$verb" in
    new) cmd_workspace_new "$@" ;;
    list) cmd_workspace_list "$@" ;;
    delete) cmd_workspace_delete "$@" ;;
    *)
      echo "muxpad: unknown workspace verb '$verb'" >&2
      echo "usage: muxpad workspace {new|list|delete}" >&2
      exit 1
      ;;
  esac
}

# ─── tab ────────────────────────────────────────────────────────────────────

cmd_tab_new() {
  # --bootstrap=shell creates the tab WITH a full-size terminal pane
  # atomically (the tabs-first default the web UI uses); --bootstrap=agent
  # creates a chat-native Claude session tab (`muxpad agent` pane, chat
  # face). Omitted → a bare tab, as before.
  reset_flags workspace name bootstrap cwd
  parse_flags workspace name bootstrap cwd -- "$@"
  local workspace_id="${FLAG_workspace:-${MUXPAD_WORKSPACE_ID:-}}"
  if [ -z "$workspace_id" ]; then
    echo "muxpad: --workspace=<id> required (no MUXPAD_WORKSPACE_ID in env)" >&2
    exit 1
  fi
  local body
  body="{\"workspace_id\":$(json_string "$workspace_id")"
  [ -n "${FLAG_name:-}" ] && body+=",\"name\":$(json_string "$FLAG_name")"
  [ -n "${FLAG_bootstrap:-}" ] && body+=",\"bootstrap\":$(json_string "$FLAG_bootstrap")"
  [ -n "${FLAG_cwd:-}" ] && body+=",\"cwd\":$(json_string "$FLAG_cwd")"
  body+='}'
  local res
  res="$(http_request POST /api/tabs "$body")"
  print_created tab "$res"
}

cmd_tab_list() {
  reset_flags workspace
  parse_flags workspace -- "$@"
  local workspace_id="${FLAG_workspace:-${MUXPAD_WORKSPACE_ID:-}}"
  if [ -z "$workspace_id" ]; then
    echo "muxpad: --workspace=<id> required (no MUXPAD_WORKSPACE_ID in env)" >&2
    exit 1
  fi
  local res
  res="$(http_request GET "/api/tabs?workspaceId=$workspace_id")"
  # STATUS/AGENTS/PIN are what the living sidebar shows; the CLI listed only
  # id + name, so a scripted or terminal-only view of a workspace could not
  # tell a tab waiting on an answer from an empty one.
  print_table "$res" \
    'ID:.id' \
    'PIN:(if .pinned then "*" else "" end)' \
    'STATUS:(.status // (if .busy then "working" else "idle" end))' \
    'AGENTS:(.agents // 0)' \
    'NAME:.name'
}

cmd_tab_delete() {
  reset_flags
  parse_flags -- "$@"
  if [ "${#POSITIONAL[@]}" -lt 1 ]; then
    echo "usage: muxpad tab delete <id>" >&2
    exit 1
  fi
  local id="${POSITIONAL[0]}"
  http_request DELETE "/api/tabs/$id" >/dev/null
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '{"deleted":"%s"}\n' "$id"
  else
    printf '%s✓%s tab deleted (%s)\n' "$C_GREEN" "$C_RESET" "$id"
  fi
}

cmd_tab() {
  local verb="${1:-}"
  if [ -z "$verb" ]; then
    echo "usage: muxpad tab {new|list|delete}" >&2
    exit 1
  fi
  shift
  case "$verb" in
    new) cmd_tab_new "$@" ;;
    list) cmd_tab_list "$@" ;;
    delete) cmd_tab_delete "$@" ;;
    *)
      echo "muxpad: unknown tab verb '$verb'" >&2
      echo "usage: muxpad tab {new|list|delete}" >&2
      exit 1
      ;;
  esac
}

# ─── pane ───────────────────────────────────────────────────────────────────

# Refuse to DEFAULT new panes into a hidden system tab:
# its layout is never shown in any sidebar, so a pane grafted there silently
# vanishes. Fires only when --tab came from the MUXPAD_TAB_ID env default —
# an explicit --tab is always honored. The check keys on the sibling
# MUXPAD_WORKSPACE_ID env var (set together with MUXPAD_TAB_ID by ptyd), one
# cheap lookup; when jq is missing or the lookup fails, err on permissive.
guard_hidden_default_tab() {
  [ -n "${MUXPAD_WORKSPACE_ID:-}" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local hidden
  hidden="$(http_request GET '/api/workspaces?all=1' 2>/dev/null |
    jq -r --arg id "$MUXPAD_WORKSPACE_ID" \
      '[.[] | select(.id == $id)] | (.[0].hidden // false) | tostring' 2>/dev/null || echo false)"
  if [ "$hidden" = "true" ]; then
    echo "muxpad: you're in the hidden system tab — a pane created here would be invisible; pass --tab=<id> (and --target=<paneId>) to place it in a visible tab" >&2
    exit 1
  fi
}

cmd_pane_new() {
  reset_flags tab cmd cwd direction target name
  parse_flags tab cmd cwd direction target name -- "$@"
  local tab_id="${FLAG_tab:-}"
  if [ -z "$tab_id" ]; then
    tab_id="${MUXPAD_TAB_ID:-}"
    if [ -z "$tab_id" ]; then
      echo "muxpad: --tab=<id> required (no MUXPAD_TAB_ID in env)" >&2
      exit 1
    fi
    guard_hidden_default_tab
  fi
  # Map the spatial direction to the server's (direction, position) wire
  # format. Server thinks in (row/column axis, before/after target);
  # users/agents think in screen geometry, so the CLI does the translation.
  local axis position
  case "${FLAG_direction:-right}" in
    right) axis='row'    ; position='after'  ;;
    left)  axis='row'    ; position='before' ;;
    below) axis='column' ; position='after'  ;;
    above) axis='column' ; position='before' ;;
    *)
      echo "muxpad: --direction must be one of: right, left, above, below (got '${FLAG_direction}')" >&2
      exit 1 ;;
  esac
  # --target=<id> wins over MUXPAD_PANE_ID. Outside a pane with no
  # --target, the body's split_from is omitted entirely and the server
  # appends at the root.
  local split_from="${FLAG_target:-${MUXPAD_PANE_ID:-}}"
  local body='{"append_to_layout":true'
  if [ -n "$split_from" ]; then
    body+=",\"split_from\":$(json_string "$split_from")"
  fi
  body+=",\"direction\":$(json_string "$axis")"
  body+=",\"position\":$(json_string "$position")"
  if [ -n "${FLAG_cmd:-}" ]; then
    body+=",\"startup_cmd\":$(json_string "$FLAG_cmd")"
  fi
  if [ -n "${FLAG_cwd:-}" ]; then
    body+=",\"cwd\":$(json_string "$FLAG_cwd")"
  fi
  body+='}'
  local res
  res="$(http_request POST "/api/tabs/$tab_id/panes" "$body")"
  # --name is applied as a follow-up PATCH (create doesn't take a name);
  # use the PATCH response for printing so the caller sees the final row.
  if [ -n "${FLAG_name:-}" ]; then
    local id
    id="$(printf '%s' "$res" | jq -r .id)"
    res="$(http_request PATCH "/api/panes/$id" "{\"name\":$(json_string "$FLAG_name")}")"
  fi
  print_created pane "$res"
}

cmd_pane_rename() {
  reset_flags
  parse_flags -- "$@"
  local id name
  if [ "${#POSITIONAL[@]}" -ge 2 ]; then
    id="${POSITIONAL[0]}"
    name="${POSITIONAL[1]}"
  elif [ "${#POSITIONAL[@]}" -eq 1 ] && [ -n "${MUXPAD_PANE_ID:-}" ]; then
    # Inside a pane, `muxpad pane rename <name>` renames the current pane.
    id="$MUXPAD_PANE_ID"
    name="${POSITIONAL[0]}"
  else
    echo "usage: muxpad pane rename [<id>] <name>   (id defaults to MUXPAD_PANE_ID)" >&2
    exit 1
  fi
  local res
  res="$(http_request PATCH "/api/panes/$id" "{\"name\":$(json_string "$name")}")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
  else
    printf '%s✓%s pane renamed (%s → %s)\n' "$C_GREEN" "$C_RESET" "$id" "$name"
  fi
}

cmd_pane_list() {
  # --all: flat list of every pane across all workspaces (the supervisor's
  # "org chart"), one line each:
  #   <pane-id>  <ws>/<tab>  <face>  <status>  <title|foreground_cmd>
  #
  # <status> is the pane's FULL five-state status (blocked|working|dead|ready|
  # idle), not the old busy/idle pair. `busy` is a deprecated alias for exactly
  # one of those five (working), so printing it collapsed "waiting on you",
  # "the runner died" and "finished, unreviewed" all into "idle" — the three
  # states a supervisor most needs to see. The `// (if .busy …)` fallback is for
  # an older server that ships `busy` but no `status`: its working panes still
  # read "working", everything else "idle".
  local a rest=()
  local all=0
  for a in "$@"; do
    case "$a" in
      --all) all=1 ;;
      *) rest+=("$a") ;;
    esac
  done
  if [ "$all" = "1" ]; then
    local res
    res="$(http_request GET /api/panes)"
    if [ "$JSON_OUTPUT" = "1" ]; then
      printf '%s\n' "$res"
      return
    fi
    # Match print_table's empty-result behaviour — this branch hand-rolls its
    # output (one line per pane, no columns) and used to print nothing at all,
    # which reads as "the command broke" rather than "no panes".
    if [ "$(printf '%s' "$res" | jq 'length')" = "0" ]; then
      printf '%s(none)%s\n' "$C_DIM" "$C_RESET"
      return
    fi
    printf '%s' "$res" | jq -r '.[] |
      "\(.id)  \(.workspace_name)/\(.tab_name)  \(.face)  \(.status // (if .busy then "working" else "idle" end))  \(.name // .title // .foreground_cmd // .url // "")"'
    return
  fi
  set -- ${rest[@]+"${rest[@]}"}
  reset_flags tab
  parse_flags tab -- "$@"
  local tab_id="${FLAG_tab:-${MUXPAD_TAB_ID:-}}"
  if [ -z "$tab_id" ]; then
    echo "muxpad: --tab=<id> required (no MUXPAD_TAB_ID in env)" >&2
    exit 1
  fi
  # GET /api/tabs/:id returns the tab with a `panes` array.
  local res
  res="$(http_request GET "/api/tabs/$tab_id")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s' "$res" | jq '.panes'
    return
  fi
  local panes
  panes="$(printf '%s' "$res" | jq '.panes')"
  print_table "$panes" \
    'ID:.id' \
    'KIND:.kind' \
    'TITLE:(.title // .foreground_cmd // .url // "")'
}

cmd_pane_delete() {
  reset_flags
  parse_flags -- "$@"
  if [ "${#POSITIONAL[@]}" -lt 1 ]; then
    echo "usage: muxpad pane delete <id>" >&2
    exit 1
  fi
  local id="${POSITIONAL[0]}"
  http_request DELETE "/api/panes/$id" >/dev/null
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '{"deleted":"%s"}\n' "$id"
  else
    printf '%s✓%s pane deleted (%s)\n' "$C_GREEN" "$C_RESET" "$id"
  fi
}

cmd_pane_open() {
  reset_flags tab direction target
  parse_flags tab direction target -- "$@"
  if [ "${#POSITIONAL[@]}" -lt 1 ]; then
    echo "usage: muxpad pane open [--tab=<id>] [--direction=right|left|above|below] [--target=<id>] <url>" >&2
    exit 1
  fi
  local url="${POSITIONAL[0]}"
  local tab_id="${FLAG_tab:-}"
  if [ -z "$tab_id" ]; then
    tab_id="${MUXPAD_TAB_ID:-}"
    if [ -z "$tab_id" ]; then
      echo "muxpad: --tab=<id> required (no MUXPAD_TAB_ID in env)" >&2
      exit 1
    fi
    guard_hidden_default_tab
  fi
  # Same direction → (axis, position) translation as cmd_pane_new.
  local axis position
  case "${FLAG_direction:-right}" in
    right) axis='row'    ; position='after'  ;;
    left)  axis='row'    ; position='before' ;;
    below) axis='column' ; position='after'  ;;
    above) axis='column' ; position='before' ;;
    *)
      echo "muxpad: --direction must be one of: right, left, above, below (got '${FLAG_direction}')" >&2
      exit 1 ;;
  esac
  local split_from="${FLAG_target:-${MUXPAD_PANE_ID:-}}"
  local body="{\"kind\":\"url\",\"url\":$(json_string "$url"),\"append_to_layout\":true"
  if [ -n "$split_from" ]; then
    body+=",\"split_from\":$(json_string "$split_from")"
  fi
  body+=",\"direction\":$(json_string "$axis")"
  body+=",\"position\":$(json_string "$position")"
  body+='}'
  local res
  res="$(http_request POST "/api/tabs/$tab_id/panes" "$body")"
  print_created pane "$res"
}

# `muxpad pane read [<id>]` — print a terminal pane's scrollback (the ring
# buffer a fresh attach would replay), ANSI-stripped so it's grep-able.
# --raw keeps the escape sequences; --lines=N trims to the last N lines.
cmd_pane_read() {
  local id='' lines='' raw=0 a no_more_flags=0
  for a in "$@"; do
    if [ "$no_more_flags" = "1" ]; then
      id="$a"
      continue
    fi
    case "$a" in
      --) no_more_flags=1 ;; # end of flags — the rest is positional verbatim
      --lines=*) lines="${a#--lines=}" ;;
      --raw) raw=1 ;;
      --*) echo "muxpad: unknown flag '$a'" >&2; exit 1 ;;
      *) id="$a" ;;
    esac
  done
  id="${id:-${MUXPAD_PANE_ID:-}}"
  if [ -z "$id" ]; then
    echo "usage: muxpad pane read [<id>] [--lines=N] [--raw]   (id defaults to MUXPAD_PANE_ID)" >&2
    exit 1
  fi
  local qs=''
  [ -n "$lines" ] && qs="?lines=$lines"
  if [ "$raw" = "1" ]; then
    if [ -n "$qs" ]; then qs+='&raw=1'; else qs='?raw=1'; fi
  fi
  http_request GET "/api/panes/$id/scrollback$qs"
}

# `muxpad pane send <id> "text"` — type into a terminal pane's live pty.
# Appends Enter by default (the dominant use is "run this command");
# --no-enter inverts. --key=<name> (repeatable) sends named keys instead:
# enter, esc, tab, up, down, left, right, ctrl-a … ctrl-z. Refused (400)
# by the server when the pane has no live pty.
cmd_pane_send() {
  local id='' text='' have_text=0 enter=1 a no_more_flags=0
  local keys=()
  for a in "$@"; do
    # `--` ends flag parsing so text that itself starts with '-' can be sent:
    #   muxpad pane send <id> -- "--help"
    if [ "$no_more_flags" = "0" ]; then
      case "$a" in
        --) no_more_flags=1; continue ;;
        --no-enter) enter=0; continue ;;
        --key=*) keys+=("${a#--key=}"); continue ;;
        --*) echo "muxpad: unknown flag '$a'" >&2; exit 1 ;;
      esac
    fi
    if [ -z "$id" ]; then
      id="$a"
    elif [ "$have_text" = "0" ]; then
      text="$a"; have_text=1
    else
      echo "muxpad pane send: too many arguments" >&2
      exit 1
    fi
  done
  if [ -z "$id" ] || { [ "$have_text" = "0" ] && [ "${#keys[@]}" = "0" ]; }; then
    echo 'usage: muxpad pane send <id> "text" [--no-enter]' >&2
    echo '       muxpad pane send <id> --key=<name> [--key=<name>…]' >&2
    exit 1
  fi
  if [ "$have_text" = "1" ] && [ "${#keys[@]}" -gt 0 ]; then
    echo "muxpad pane send: text and --key are mutually exclusive" >&2
    exit 1
  fi
  local body
  if [ "${#keys[@]}" -gt 0 ]; then
    local keys_json
    keys_json="$(printf '%s\n' "${keys[@]}" | jq -R . | jq -sc .)"
    body="{\"keys\":$keys_json}"
  else
    local enter_json=false
    [ "$enter" = "1" ] && enter_json=true
    body="{\"text\":$(json_string "$text"),\"enter\":$enter_json}"
  fi
  http_request POST "/api/panes/$id/input" "$body" >/dev/null
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '{"sent":"%s"}\n' "$id"
  else
    printf '%s✓%s input sent to %s\n' "$C_GREEN" "$C_RESET" "$id"
  fi
}

# `muxpad pane summarize [<id>]` — 1–2 sentence deliverable summary of an
# agent pane's conversation (the same summary the doc surface's collapsed
# agent block shows). Best-effort server-side; empty when there's nothing.
cmd_pane_summarize() {
  reset_flags
  parse_flags -- "$@"
  local id="${POSITIONAL[0]:-${MUXPAD_PANE_ID:-}}"
  if [ -z "$id" ]; then
    echo "usage: muxpad pane summarize [<id>]   (id defaults to MUXPAD_PANE_ID)" >&2
    exit 1
  fi
  local res
  res="$(http_request POST "/api/panes/$id/summarize")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
    return
  fi
  local title summary
  title="$(printf '%s' "$res" | jq -r '.title // empty')"
  summary="$(printf '%s' "$res" | jq -r '.summary // empty')"
  [ -n "$title" ] && printf '%s%s%s\n' "$C_BOLD" "$title" "$C_RESET"
  if [ -n "$summary" ]; then
    printf '%s\n' "$summary"
  else
    printf '%s(no summary — pane has no agent conversation yet)%s\n' "$C_DIM" "$C_RESET"
  fi
  printf '%s' "$res" | jq -r '.artifacts[]? | "  artifact: \(.)"'
}

cmd_pane() {
  local verb="${1:-}"
  if [ -z "$verb" ]; then
    echo "usage: muxpad pane {new|list|read|send|delete|open|rename|summarize}" >&2
    exit 1
  fi
  shift
  case "$verb" in
    new) cmd_pane_new "$@" ;;
    list) cmd_pane_list "$@" ;;
    read) cmd_pane_read "$@" ;;
    send) cmd_pane_send "$@" ;;
    delete) cmd_pane_delete "$@" ;;
    open) cmd_pane_open "$@" ;;
    rename) cmd_pane_rename "$@" ;;
    summarize) cmd_pane_summarize "$@" ;;
    *)
      echo "muxpad: unknown pane verb '$verb'" >&2
      echo "usage: muxpad pane {new|list|read|send|delete|open|rename|summarize}" >&2
      exit 1
      ;;
  esac
}

# `muxpad open <url>` opens a URL in a real browser tab (window.open),
# NOT as an iframe pane inside the muxpad mosaic. Mirrors macOS's `open`
# and Linux's `xdg-open`. For the in-mosaic iframe version, use
# `muxpad pane open <url>`.
#
# The server fans the request out as an `external_url.open` event on the
# /ws/events stream; the web UI surfaces it as a click-to-open toast so
# the actual window.open() call lands inside a user-gesture handler
# (popup-blocker safe). When called inside a muxpad pane:
#   - MUXPAD_TAB_ID scopes the toast to the muxpad tab the call came from
#     (other muxpad tabs in the browser stay quiet).
#   - MUXPAD_PANE_ID lets the server label the toast with the pane's
#     title / foreground command so the user knows who asked.
cmd_open() {
  reset_flags
  parse_flags -- "$@"
  if [ "${#POSITIONAL[@]}" -lt 1 ]; then
    echo "usage: muxpad open <url>" >&2
    exit 1
  fi
  local url="${POSITIONAL[0]}"
  local body="{\"url\":$(json_string "$url")"
  if [ -n "${MUXPAD_TAB_ID:-}" ]; then
    body+=",\"tab_id\":$(json_string "$MUXPAD_TAB_ID")"
  fi
  if [ -n "${MUXPAD_PANE_ID:-}" ]; then
    body+=",\"pane_id\":$(json_string "$MUXPAD_PANE_ID")"
  fi
  body+='}'
  http_request POST /api/open/external "$body" >/dev/null
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '{"requested":%s}\n' "$(json_string "$url")"
  else
    printf '%s✓%s requested external open: %s\n' "$C_GREEN" "$C_RESET" "$url"
  fi
}

# `muxpad watch [--types=a,b]` — stream the daemon's event bus to stdout,
# one event per line, until killed. This is `tail -f` over the whole mosaic:
# pane/tab/workspace changes plus agent_turn start/done/fatal. Curls the SSE
# mirror (GET /api/events) rather than holding a WS open — bash-friendly.
# --types filters server-side; --json prints the raw MuxpadEvent JSON,
# default is a compact human one-liner per event.
cmd_watch() {
  reset_flags types
  parse_flags types -- "$@"
  require_api_url
  local qs=''
  [ -n "${FLAG_types:-}" ] && qs="?types=$FLAG_types"
  # -N: no output buffering — events must land as they happen, not in 4k
  # chunks. SSE frames are `data: <json>` lines; comments (`: hb`
  # heartbeats, `: connected` handshake) and blank separators are dropped.
  local line payload
  curl -sN "${MUXPAD_API_URL%/}/api/events$qs" | while IFS= read -r line; do
    case "$line" in
      data:*)
        payload="${line#data:}"
        payload="${payload# }"
        if [ "$JSON_OUTPUT" = "1" ]; then
          printf '%s\n' "$payload"
        else
          printf '%s' "$payload" | jq -r '
            if .type == "agent_turn" then
              "\(.type)  \(.pane_id)  \(.phase)  \(.backend)\(if .sid then "  sid=\(.sid)" else "" end)"
            else
              "\(.type)  \(.pane_id // .pane.id // .tab_id // .tab.id // .workspace_id // .workspace.id // .url // "")"
            end'
        fi
        ;;
    esac
  done
}

# `muxpad app-url <url> [--label=<text>]` declares the web app THIS pane is
# serving. It prints a muxpad-private OSC escape (code 7771) to the pane's
# own stdout; the daemon's per-pane output scanner picks it up, confirms the
# port is actually listening, and offers it as a "switch to web view" entry
# in the pane chrome. This is the explicit, zero-false-positive path — far
# more reliable than muxpad scraping a URL out of arbitrary output. Run it
# from your dev script once the server is up:
#   muxpad app-url "http://localhost:5173" --label Web
# The escape is invisible in the terminal. Must be run inside a pane (the
# marker is meaningless elsewhere). The URL must not contain ';' (the OSC
# field separator).
cmd_app_url() {
  if [ -z "${MUXPAD_PANE_ID:-}" ]; then
    echo "muxpad app-url: must be run inside a muxpad pane" >&2
    exit 1
  fi
  reset_flags label
  parse_flags label -- "$@"
  if [ "${#POSITIONAL[@]}" -lt 1 ]; then
    echo "usage: muxpad app-url <url> [--label=<text>]" >&2
    exit 1
  fi
  local url="${POSITIONAL[0]}"
  local label="${FLAG_label:-}"
  case "$url" in
    *';'*) echo "muxpad app-url: url must not contain ';'" >&2; exit 1 ;;
    http://*|https://*) ;;
    *) echo "muxpad app-url: url must be http:// or https://" >&2; exit 1 ;;
  esac
  # Strip ';' from the label so it can't break the marker's field parsing.
  label="${label//;/}"
  # OSC 7771 ; muxpad ; app ; url=<url>[ ; label=<label> ] BEL
  if [ -n "$label" ]; then
    printf '\033]7771;muxpad;app;url=%s;label=%s\007' "$url" "$label"
  else
    printf '\033]7771;muxpad;app;url=%s\007' "$url"
  fi
}

# `muxpad serve [--url <url>] [--label <text>] -- <command...>` — run a local
# web server IN THIS PANE under muxpad supervision:
#   - declares the app URL (OSC marker) so the pane flips to its web face and
#     the face menu offers Terminal ⇄ Web — same pattern as agent chat panes;
#   - restarts the command when it dies (crash-loop backoff: quick deaths
#     back off 2s→30s; a run that lived >10s resets to 2s);
#   - Ctrl-C stops for real (the loop exits instead of restarting).
# The web face's dead-URL probe shows "server stopped" during the gap and
# self-heals when the restart comes up — no manual reload.
cmd_serve() {
  if [ -z "${MUXPAD_PANE_ID:-}" ]; then
    echo "muxpad serve: must be run inside a muxpad pane" >&2
    exit 1
  fi
  reset_flags url label
  parse_flags url label -- "$@"
  if [ "${#POSITIONAL[@]}" -lt 1 ]; then
    echo 'usage: muxpad serve [--url <url>] [--label <text>] -- <command...>' >&2
    exit 1
  fi
  # Snapshot NOW: FLAG_*/POSITIONAL are globals, and cmd_app_url below runs
  # its own reset/parse_flags — without copies the loop would execute the
  # URL as the command on round two.
  local serve_url="${FLAG_url:-}" serve_label="${FLAG_label:-}"
  local cmdv=("${POSITIONAL[@]}")
  local stopped=0
  trap 'stopped=1' INT TERM
  local backoff=2
  while :; do
    # (Re)declare the app URL each round — idempotent server-side, and it
    # only flips the face when the URL is NEW to this pane, so a user who
    # switched to the terminal view stays there across restarts.
    if [ -n "$serve_url" ]; then
      if [ -n "$serve_label" ]; then
        cmd_app_url "$serve_url" --label "$serve_label"
      else
        cmd_app_url "$serve_url"
      fi
    fi
    local started=$SECONDS code=0
    "${cmdv[@]}" || code=$?
    local ran=$((SECONDS - started))
    if [ "$stopped" = "1" ]; then
      echo "muxpad serve: stopped"
      break
    fi
    # Crash-loop backoff: a server that dies within 10s of starting doubles
    # the wait (max 30s); a healthy long run resets it.
    if [ "$ran" -lt 10 ]; then
      backoff=$((backoff * 2)); [ "$backoff" -gt 30 ] && backoff=30
    else
      backoff=2
    fi
    echo "muxpad serve: command exited (code $code, ran ${ran}s) — restarting in ${backoff}s (Ctrl-C to stop)"
    sleep "$backoff" || break
  done
}

# `muxpad tunnel --port <public port>` — run and OWN the Cloudflare quick
# tunnel that makes published artifacts reachable from the internet.
#
# Not meant to be typed. muxpad registers it as an app (slug `tunnel`) on the
# first publish, so it runs inside a supervised hidden pane where ptyd owns it
# and it survives a main-server restart — see server/src/tunnel/TunnelApp.ts.
# `muxpad app logs tunnel` shows cloudflared's own output; `muxpad app stop
# tunnel` closes the door.
#
# The work is node, not bash, for one reason: the load-bearing step is parsing
# the hostname out of cloudflared's banner (a quick tunnel mints a NEW random
# name on every start), and that parser has to be unit-tested against real
# captured output. A grep in a shell loop cannot be.
cmd_tunnel() {
  if [ "${1:-}" = "setup" ]; then
    shift
    cmd_tunnel_setup "$@"
    return
  fi
  local runner="$ROOT/server/dist/tunnel/index.js"
  if [ ! -f "$runner" ]; then
    echo "muxpad tunnel: not built ($runner missing) — run 'pnpm build' in $ROOT" >&2
    exit 1
  fi
  exec node "$runner" "$@"
}

# `muxpad tunnel setup <hostname> [--name=muxpad] [--relogin]` — turn published
# links PERMANENT and PUBLIC, in one command.
#
# DOMAIN-AGNOSTIC BY CONSTRUCTION. The hostname is an argument and muxpad knows
# nothing else about it: any name, any depth, any zone on the user's Cloudflare
# account. No domain is assumed, defaulted or suggested anywhere in this script —
# the one thing it does know how to check is whether the zone it was handed is on
# Cloudflare at all, which it asks over plain DNS before touching anything.
#
# WHAT IT IS FOR. The default published link is your tailnet address: permanent,
# but reachable only from your own devices. The quick tunnel is public, but
# Cloudflare reassigns its four-word hostname on every restart, so every link
# built from one dies at the next deploy. A NAMED tunnel is the only option that
# is both — you own the hostname, it is a CNAME to a UUID whose credentials live
# on disk, and it survives restarts, reboots and a new IP.
#
# WHY IT IS A COMMAND AND NOT A CHECKLIST. The steps are `login`, `create`,
# `route dns` and remembering what you chose, and getting any of them subtly
# wrong leaves a hostname that resolves nowhere. Only ONE of them genuinely needs
# a human — the browser login, which is an OAuth flow against your own Cloudflare
# account — and this skips even that when the account cert is already there.
#
# WHAT IT DELIBERATELY DOES NOT DO: set MUXPAD_PUBLIC_BASE_URL. It does not need
# to. The hostname lands in the ordinary tunnel announce, public-base.ts reads a
# real domain off the host and classes it `permanent`, and the durability ranking
# puts it above everything. No plist, no launchd job, no daemon restart.
cmd_tunnel_setup() {
  local hostname='' name='muxpad' relogin=0 skip_zone=0 a
  for a in "$@"; do
    case "$a" in
      --hostname=*) hostname="${a#--hostname=}" ;;
      --name=*) name="${a#--name=}" ;;
      --relogin) relogin=1 ;;
      # The zone check has one real false-negative case — Cloudflare's custom /
      # vanity nameservers replace the `*.ns.cloudflare.com` pair, so a zone that
      # IS on Cloudflare can look like it is not. A hard block with no way
      # through would be worse than no block.
      --skip-zone-check) skip_zone=1 ;;
      -*) echo "muxpad tunnel setup: unknown flag '$a'" >&2; exit 1 ;;
      # THE HOSTNAME IS AN ARGUMENT, and muxpad knows nothing else about it. Any
      # zone on the user's Cloudflare account works; nothing here assumes a
      # domain, a naming convention, or a depth.
      *)
        if [ -n "$hostname" ]; then
          echo "muxpad tunnel setup: two hostnames given ('$hostname' and '$a')" >&2
          exit 1
        fi
        hostname="$a"
        ;;
    esac
  done

  if [ -z "$hostname" ]; then
    cat >&2 <<'EOF'
muxpad tunnel setup: a hostname is required.

  muxpad tunnel setup pub.example.com

Any hostname in any zone on your Cloudflare account. The zone has to be on
Cloudflare nameservers, because the tunnel writes a CNAME into it — if it is not,
this will tell you exactly what to do rather than failing at the CNAME.

One thing worth knowing before you choose: a FIRST-level subdomain
(pub.example.com) is covered by free Universal SSL. Going deeper
(<slug>.pub.example.com) needs Advanced Certificate Manager at $10/month and buys
nothing muxpad can use — the public server routes by PATH, not by Host header.
EOF
    exit 1
  fi

  # Validated HERE, before anything touches the account. The same shape
  # server/src/tunnel/named.ts enforces on read: a bare hostname, because this
  # value becomes the origin of every published link and a scheme would produce
  # `https://https://…` downstream.
  case "$hostname" in
    *://* | */* | *:* | *' '* | '')
      echo "muxpad tunnel setup: '$hostname' must be a bare hostname — no scheme, no port, no path" >&2
      exit 1
      ;;
  esac
  if ! printf '%s' "$hostname" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+$'; then
    echo "muxpad tunnel setup: '$hostname' must be a bare hostname" >&2
    exit 1
  fi

  # IS THAT ZONE EVEN ON CLOUDFLARE? Asked FIRST, over plain DNS, because it is
  # the one precondition muxpad can check for itself and the one whose native
  # failure is useless: `cloudflared tunnel route dns` against a zone Cloudflare
  # is not the authority for returns an API error that mentions neither
  # nameservers nor a registrar — and by then a tunnel has been created and a
  # browser login spent.
  #
  # Overridable binary for the same reason as MUXPAD_TAILSCALE_BIN: a test must
  # drive this rather than depend on the network and on who owns the example
  # domain this week.
  local dig_bin="${MUXPAD_DIG_BIN:-dig}"
  local apex='' zone_ns=''
  local probe="$hostname"
  # Walk UP from the hostname and take the longest suffix that has its own NS
  # records — that is the zone apex. This is why there is no public-suffix list
  # here and why `pub.example.co.uk` still works: `example.co.uk` has NS records
  # and `pub.example.co.uk` does not, so the walk stops in the right place.
  while [ "$skip_zone" = "0" ] && [ -n "$probe" ] && [ "$probe" != "${probe#*.}" ]; do
    # `+noall +answer` and an explicit type filter, NOT `+short`. `+short NS`
    # follows a CNAME and prints the chain, so a hostname that is already a CNAME
    # (`www.bbc.co.uk`, measured) reads as though it were its own zone — the walk
    # stops at the wrong level and the advice names the wrong domain. Column 4 is
    # the record type; only a real NS line counts.
    zone_ns="$("$dig_bin" +noall +answer +time=3 +tries=1 NS "$probe" 2>/dev/null \
      | awk '$4 == "NS" { print $5 }' | grep -v '^$' || true)"
    if [ -n "$zone_ns" ]; then
      apex="$probe"
      break
    fi
    probe="${probe#*.}"
  done

  if [ "$skip_zone" = "1" ]; then
    # Taken at the user's word. `apex` is only used for messages from here on;
    # the hostname stands in for it.
    apex="$hostname"
    printf '%s!%s skipping the Cloudflare zone check for %s\n' "$C_DIM" "$C_RESET" "$hostname"
  elif [ -z "$apex" ]; then
    cat >&2 <<EOF
muxpad tunnel setup: found no DNS zone for $hostname.

Nothing in that name answers an NS query, which usually means the domain is not
registered, or it is a typo. Check the spelling; if the domain is new, DNS may
not have propagated yet.

Nothing was changed.
EOF
    exit 1
  fi

  if [ "$skip_zone" = "0" ] && ! printf '%s' "$zone_ns" | grep -qi '\.ns\.cloudflare\.com\.\?$'; then
    cat >&2 <<EOF
muxpad tunnel setup: the zone $apex is not on Cloudflare.

Its nameservers right now are:

$(printf '%s' "$zone_ns" | sed 's/^/    /')

A tunnel hostname is a CNAME that Cloudflare has to be able to write, so $apex
has to use Cloudflare as its DNS authority first. That is free, and it is three
things:

  1. dash.cloudflare.com → "Add a site" → enter: $apex   (the Free plan is fine)
  2. Let Cloudflare scan the existing DNS records, and CHECK THE LIST it found.
     Repointing nameservers moves the WHOLE ZONE, not just this one name — if a
     website, mail (MX), or anything else lives on $apex and its records are not
     in that list, add them before step 3 or they go dark.
  3. At the registrar those nameservers point to today, replace them with the two
     Cloudflare gives you. Cloudflare emails you when the zone goes active —
     usually minutes, occasionally a few hours.

Then re-run:

  muxpad tunnel setup $hostname

Nothing was changed, and nothing was created on your Cloudflare account.

If you would rather not move that zone: pick a hostname in a domain you already
have on Cloudflare, or leave it — published links already default to your tailnet
address, which is permanent and works on all your own devices.

Already on Cloudflare with CUSTOM (vanity) nameservers? Then this check is simply
wrong about you — it looks for the \`*.ns.cloudflare.com\` pair. Re-run with
--skip-zone-check.
EOF
    exit 1
  fi
  [ "$skip_zone" = "0" ] && printf '%s✓%s %s is on Cloudflare\n' "$C_GREEN" "$C_RESET" "$apex"

  # Honour the same override the server uses, so a test can drive this without a
  # Cloudflare account and a Homebrew-less machine can point at its own binary.
  local cf="${MUXPAD_CLOUDFLARED_BIN:-}"
  if [ -z "$cf" ]; then
    cf="$(command -v cloudflared 2>/dev/null || true)"
    [ -z "$cf" ] && [ -x /opt/homebrew/bin/cloudflared ] && cf=/opt/homebrew/bin/cloudflared
    [ -z "$cf" ] && [ -x /usr/local/bin/cloudflared ] && cf=/usr/local/bin/cloudflared
  fi
  if [ -z "$cf" ] || [ ! -x "$cf" ]; then
    cat >&2 <<EOF
muxpad tunnel setup: cloudflared is not installed.

  brew install cloudflared

Then re-run: muxpad tunnel setup --hostname=$hostname
EOF
    exit 1
  fi

  # cloudflared's own home. Overridable so the test above never reads or writes
  # the real one — those are live credentials for a real account.
  local cfhome="${MUXPAD_CLOUDFLARED_HOME:-$HOME/.cloudflared}"
  mkdir -p "$cfhome"
  # Exported ONCE, and as the env var cloudflared documents rather than
  # `--origincert` on four command lines. Two reasons: the commands below then
  # read exactly like the ones printed for a human to copy (a flag they do not
  # need is a flag they will paste), and every call is covered — an earlier draft
  # set it only on `login`, leaving `create` and `route dns` reading the DEFAULT
  # `~/.cloudflared/cert.pem` while the rest of the command used the override.
  export TUNNEL_ORIGIN_CERT="$cfhome/cert.pem"

  # STEP 1 — the account login. The ONE step that needs a human, and the one
  # thing this command will not do twice: cert.pem is the account credential and
  # re-running the flow would open a browser to re-learn what is already known.
  # `--relogin` forces it, because the cert is scoped to the zone picked at login
  # time and a DIFFERENT domain later needs another one — without the flag the
  # only way through is deleting cert.pem by hand.
  if [ -f "$cfhome/cert.pem" ] && [ "$relogin" = "0" ]; then
    printf '%s✓%s already logged in to Cloudflare (%s)\n' "$C_GREEN" "$C_RESET" "$cfhome/cert.pem"
  else
    printf '%s→%s opening your browser to authorise cloudflared — pick the zone %s\n' \
      "$C_DIM" "$C_RESET" "$apex"
    if ! "$cf" tunnel login; then
      echo 'muxpad tunnel setup: cloudflared tunnel login failed — nothing was changed' >&2
      exit 1
    fi
  fi

  # STEP 2 — the tunnel. Reusing an existing one by name makes re-running this
  # safe, which matters because the most likely reason to re-run it is a typo in
  # the hostname on the first attempt.
  local existing_id=''
  existing_id="$("$cf" tunnel list -o json -n "$name" 2>/dev/null \
    | jq -r 'if type == "array" then (.[0].id // empty) else empty end' 2>/dev/null || true)"
  if [ -n "$existing_id" ]; then
    printf '%s✓%s tunnel %s already exists (%s)\n' "$C_GREEN" "$C_RESET" "$name" "$existing_id"
  else
    printf '%s→%s creating tunnel %s\n' "$C_DIM" "$C_RESET" "$name"
    if ! "$cf" tunnel create "$name"; then
      echo "muxpad tunnel setup: cloudflared tunnel create $name failed" >&2
      exit 1
    fi
  fi

  # The credentials file `create` wrote. FOUND, not guessed: muxpad treats this
  # file's existence as "the tunnel is runnable" (server/src/tunnel/named.ts), so
  # recording a path that is not there would mean announcing a permanent hostname
  # in front of a cloudflared that cannot authenticate.
  local creds=''
  if [ -n "$existing_id" ] && [ -f "$cfhome/$existing_id.json" ]; then
    creds="$cfhome/$existing_id.json"
  else
    creds="$(ls -t "$cfhome"/*.json 2>/dev/null | head -1 || true)"
  fi
  if [ -z "$creds" ] || [ ! -f "$creds" ]; then
    cat >&2 <<EOF
muxpad tunnel setup: no tunnel credentials file in $cfhome.

\`cloudflared tunnel create $name\` should have written one. If the tunnel exists
but its credentials are on another machine, fetch them with:

  cloudflared tunnel token --cred-file $cfhome/$name.json $name
EOF
    exit 1
  fi

  # STEP 3 — the CNAME. Before writing any config, because a hostname with no
  # route resolves nowhere, and a config written anyway would have muxpad publish
  # links to a permanent address that is permanently dead.
  #
  # IS IT ALREADY ROUTED HERE? Asked first, because `cloudflared tunnel route dns`
  # REFUSES an existing record without -f, and "re-running this is safe" has to be
  # true — it was not. Found on the machine this was built for: the hostname had
  # been routed by hand before muxpad knew about it, so setup failed at its last
  # step on the one case that mattered most.
  #
  # Decided by FINGERPRINT, not by the Cloudflare API: the hostname must answer
  # like muxpad's public artifact server — a 404 at `/` carrying a sandbox CSP,
  # the same positive check run.ts makes before it will tunnel anything. A bare
  # 404 is somebody else's server or a parked name, and skipping the route on
  # that evidence would leave the hostname pointing wherever it already pointed
  # while muxpad announced it as its own base.
  local probe_url="${MUXPAD_TUNNEL_PROBE_URL:-https://$hostname}"
  local probe_hdrs=''
  probe_hdrs="$(curl -sS -o /dev/null -D - --max-time 8 "$probe_url/" 2>/dev/null || true)"
  local already=0
  if printf '%s' "$probe_hdrs" | grep -qiE '^HTTP/[0-9.]+ 404' \
    && printf '%s' "$probe_hdrs" | grep -qi '^content-security-policy: *sandbox'; then
    already=1
  fi

  if [ "$already" = "1" ]; then
    printf '%s✓%s %s is already routed to this machine — leaving the DNS record alone\n' \
      "$C_GREEN" "$C_RESET" "$hostname"
  else
  printf '%s→%s routing %s to the tunnel\n' "$C_DIM" "$C_RESET" "$hostname"
  if ! "$cf" tunnel route dns "$name" "$hostname"; then
    cat >&2 <<EOF
muxpad tunnel setup: could not route $hostname to tunnel $name.

$apex IS on Cloudflare (checked above), so the two likely causes are:

  · THE LOGIN DOES NOT COVER THIS ZONE. \`cloudflared tunnel login\` writes a
    cert scoped to the zone you picked, so a hostname in a different one is
    refused. Re-authorise, picking $apex:

      muxpad tunnel setup $hostname --relogin

  · A RECORD FOR THAT NAME ALREADY EXISTS. Replace it — check what it is first:

      $cf tunnel route dns -f $name $hostname

No config was written, so re-running this is safe either way.
EOF
    exit 1
  fi
  fi

  # STEP 4 — tell muxpad. The server re-reads this on every publish, so it takes
  # effect with no restart.
  local cfg="$DATA_DIR/tunnel.json"
  jq -n --arg n "$name" --arg h "$hostname" --arg c "$creds" \
    '{name: $n, hostname: $h, credentials_file: $c}' > "$cfg"

  # STEP 5 — hand the tunnel to muxpad. The app's pane bakes its startup command
  # in at materialise time and the runner reads the config at ITS start, so a
  # tunnel that is already running is still running in QUICK mode until its pane
  # is rebuilt. Restarting the app here is what makes one command enough; without
  # it the hostname stays ephemeral until the next accidental restart.
  #
  # Best-effort: an instance with no tunnel app registered yet has nothing to
  # restart, and the first publish will start it in named mode anyway.
  if "$0" app list --json 2>/dev/null | jq -e '.[]? | select(.slug == "tunnel")' >/dev/null 2>&1; then
    printf '%s→%s restarting the tunnel app so it runs the NAMED tunnel\n' "$C_DIM" "$C_RESET"
    "$0" app restart tunnel >/dev/null 2>&1 || true
  fi

  printf '\n%s✓%s published links are now permanent AND public:\n' "$C_GREEN" "$C_RESET"
  printf '    https://%s/<slug>/\n\n' "$hostname"
  cat <<EOF
  config:  $cfg
  creds:   $creds  (back this up — it is what claims the hostname)

Nothing else to do. To confirm:

  muxpad publish --base      # expect: keeps: yes

The quick tunnel's four-word hostnames are done with, and any link that died
with one comes back under this name:

  muxpad publish --url <slug>
EOF
  return 0
}

# `muxpad claude [claude args...]` — launch Claude Code in THIS pane as a
# muxpad-tracked agent session, so it can later be viewed/driven from the web
# chat and switched between terminal and chat. Passthrough that AUGMENTS: runs
# the real `claude` with your exact args, injecting only what muxpad needs to
# know the session, then exec's it so the terminal is byte-identical to
# running `claude` directly.
#   - Mints a --session-id (unless you passed your own).
#   - Installs a SessionStart hook (via --settings, unless you passed your
#     own) that reports the real session-id back on every start/resume/
#     compact/fork.
#   - Pre-registers the session so the tracker has a row before the first
#     prompt creates the transcript. All best-effort — never blocks the launch.
# See docs/plans/2026-07-01-web-chat-session-switching.md.
cmd_claude() {
  if [ -z "${MUXPAD_PANE_ID:-}" ]; then
    echo "muxpad claude: must be run inside a muxpad pane (no MUXPAD_PANE_ID)" >&2
    exit 1
  fi

  # Respect user-supplied --session-id / --settings / system-prompt flags;
  # only inject ours when absent.
  local user_has_sid=0 user_has_settings=0 user_is_resume=0 user_has_sysprompt=0 a
  for a in "$@"; do
    case "$a" in
      --session-id|--session-id=*) user_has_sid=1 ;;
      --settings|--settings=*) user_has_settings=1 ;;
      --resume|--resume=*|-r|--continue|-c) user_is_resume=1 ;;
      --system-prompt|--system-prompt=*|--system-prompt-file|--system-prompt-file=*|\
      --append-system-prompt|--append-system-prompt=*|--append-system-prompt-file|--append-system-prompt-file=*)
        user_has_sysprompt=1 ;;
    esac
  done

  local extra=() sid=""
  # Don't mint a --session-id when resuming: claude rejects --session-id with
  # --resume/--continue. The SessionStart hook still reports the resumed id.
  if [ "$user_has_sid" = "0" ] && [ "$user_is_resume" = "0" ]; then
    sid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    extra+=(--session-id "$sid")
  fi
  if [ "$user_has_settings" = "0" ]; then
    local hooks_dir="$DATA_DIR/agent-hooks"
    mkdir -p "$hooks_dir"
    local settings_file="$hooks_dir/$MUXPAD_PANE_ID.json"
    # SessionStart hook → `muxpad _agent-hook`, which reads the hook payload
    # on stdin, pulls session_id, and reports it for THIS pane. The bin path
    # is shell-quoted — the hook command runs through a shell, and an
    # unquoted path with a space would silently never fire.
    printf '{"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":%s}]}]}}\n' \
      "$(json_string "\"${MUXPAD_BIN:-muxpad}\" _agent-hook")" > "$settings_file"
    extra+=(--settings "$settings_file")
  else
    echo "muxpad claude: --settings supplied; skipping hook injection (this session won't be web-switchable)" >&2
  fi

  # Universal muxpad instructions — the server-GENERATED
  # <dataDir>/agent-instructions.md followed by the user's
  # <dataDir>/agent-notes.md, the same order every backend injects them in.
  # Appended via claude's native --append-system-prompt, which works for the
  # interactive TUI too. Skipped when the user passed any system-prompt flag of
  # their own; a missing/empty file simply contributes nothing (never an error).
  #
  # Chat mode rides the SAME flag, appended after the instructions (behavior
  # last, matching the SDK backend's append order). The pane's mode is read
  # from the API with a tolerant grep — jq is NOT required for `muxpad claude`
  # and adding a hard dependency here would break launching the TUI on a box
  # without it. Every step is best-effort: a down server, an old server with
  # no `mode` field, or a missing file all fall through to AGENT mode, which
  # is the historical behavior.
  #
  # This is why the pane-row default had to stay 'agent' when the CREATION
  # default flipped to 'chat': a `muxpad claude` typed into a plain terminal
  # reads THIS row, and a shell pane stamped 'chat' would have silently
  # overlaid muxpad's contract on a session the user launched by hand. Only a
  # pane explicitly put in Chat mode gets the overlay. The pre-rename 'do' is
  # still honoured for one release, for a pane row an older server wrote.
  if [ "$user_has_sysprompt" = "0" ]; then
    local sysprompt="" part
    for part in agent-instructions.md agent-notes.md; do
      [ -s "$DATA_DIR/$part" ] || continue
      sysprompt="${sysprompt:+$sysprompt$'\n\n'}$(cat "$DATA_DIR/$part")"
    done
    if [ -s "$DATA_DIR/chat-mode.md" ] && [ -n "${MUXPAD_API_URL:-}" ]; then
      local pane_mode
      pane_mode="$(curl -sS --max-time 3 \
        "${MUXPAD_API_URL%/}/api/panes/$MUXPAD_PANE_ID" 2>/dev/null \
        | grep -o '"mode"[[:space:]]*:[[:space:]]*"[a-z]*"' \
        | head -1 | grep -o '[a-z]*"$' | tr -d '"')" || pane_mode=""
      if [ "$pane_mode" = "chat" ] || [ "$pane_mode" = "do" ]; then
        sysprompt="${sysprompt:+$sysprompt$'\n\n'}$(cat "$DATA_DIR/chat-mode.md")"
      fi
    fi
    [ -n "$sysprompt" ] && extra+=(--append-system-prompt "$sysprompt")
  fi

  # Pre-register (best-effort; the launch must succeed even if the daemon is
  # unreachable or slow).
  if [ -n "${MUXPAD_API_URL:-}" ]; then
    local body
    # $$ is this script's PID, which `exec claude` below inherits — so it is
    # claude's runtime PID. The server SIGTERMs it to hand the session from the
    # terminal to chat (a clean stop; no fragile keystrokes).
    body="{\"pane_id\":$(json_string "$MUXPAD_PANE_ID"),\"assistant\":\"claude\",\"cwd\":$(json_string "$PWD"),\"pid\":$$"
    [ -n "$sid" ] && body+=",\"session_id\":$(json_string "$sid")"
    body+='}'
    # Subshell so http_request's exit-on-non-2xx (e.g. an older server with
    # no /api/agent-sessions route) can't abort the launch. Registration is
    # best-effort; the SessionStart hook re-reports the id anyway.
    ( http_request POST /api/agent-sessions/register "$body" ) >/dev/null 2>&1 || true
  fi

  if [ "${#extra[@]}" -gt 0 ]; then
    exec claude "$@" "${extra[@]}"
  else
    exec claude "$@"
  fi
}

# `muxpad agent [--resume <sid>]` — run a persistent, chat-native Claude
# session in THIS pane. Unlike `muxpad claude` (the interactive TUI), this
# hosts the session via the Agent SDK and is driven from the pane's web chat
# face; the terminal shows a compact activity log. The pane's startup command
# is rewritten to `muxpad agent --resume <sid>` by the server, so a ptyd
# restart or reboot springs the pane back into the same session from disk.
# The base URL to PRINT in a link a human will click.
#
# `MUXPAD_API_URL` is what this CLI talks to, which is loopback — correct for
# an API call from this machine and useless in a link, because the person
# reading it is usually on a phone. A wildcard bind is worse: `0.0.0.0` is not
# connectable at all.
#
# So prefer a reachable hostname when the machine has one. Tailscale's MagicDNS
# name is the right default here: muxpad's cockpit is deliberately tailnet-only
# (an unauthenticated cockpit must never sit on a public funnel — see
# funnel.ts), so the ts.net name is exactly as private as loopback and works
# from every device the user owns. Falls back to loopback when there is no
# tailnet, which is the honest answer on a standalone machine.
printable_base() {
  local base="${MUXPAD_API_URL%/}"
  base="${base/0.0.0.0/127.0.0.1}"
  # MUXPAD_PUBLIC_BASE_URL IS DELIBERATELY NOT CONSULTED HERE, and used to be.
  #
  # It is the ARTIFACT origin — config.ts: "the origin published artifact links
  # are built from" — and this function builds the COCKPIT url, the
  # `<base>/w/<ws>/t/<tab>` that `muxpad agent new` prints. Those are two
  # different hosts on purpose. The artifact server is :7778: loopback-bound,
  # serving nothing but `/<slug>/`, and the one intended to face the internet.
  # The cockpit is :7777, it has NO authentication whatsoever, and its entire
  # security model is being reachable only from the tailnet.
  #
  # So borrowing the artifact origin was wrong twice over: the printed link
  # 404s (the public server has no `/w/...` route), and it puts a private,
  # unauthenticated surface behind a name chosen to be public — the wrong
  # direction to get confused in. The cockpit base is the tailnet name, which
  # the rest of this function already works out; `candidates()` in
  # public-base.ts still offers the persisted *.ts.net url when `env` is set,
  # so nothing is lost by not looking here.
  #
  # Ask the SERVER for a hostname it already knows, rather than executing the
  # Tailscale binary inside /Applications/Tailscale.app. Reaching into another
  # app's bundle is what makes macOS put up "node would like to access data
  # from other apps" — once per invocation, on the machine running muxpad.
  #
  # The candidate list is published for the PUBLISH base (artifacts, on :8443),
  # so its port is wrong for the cockpit; only the HOST is borrowed. The bare
  # hostname reaches the cockpit because muxpad's tailnet serve puts :443 there
  # (tailnet-only — an unauthenticated cockpit is never on a public funnel).
  #
  # `probe=0` and `|| true` for the same two reasons publish_base_url has them:
  # only the candidate LIST is wanted, so paying for a reachability walk is
  # pointless; and under this script's `set -euo pipefail` a curl that fails or
  # outruns the 2s budget makes the assignment non-zero and `set -e` kills the
  # script. That last one bites hardest right here — `muxpad agent new` calls
  # this at the very END, after the tab is created and the first message
  # delivered, so an abort would lose the URL for work already done.
  local host
  host="$(curl -sS --max-time 2 "${MUXPAD_API_URL%/}/api/publish/base?probe=0" 2>/dev/null \
    | jq -r '[.candidates[]?.url] | map(select(test("\\.ts\\.net"))) | .[0] // ""' 2>/dev/null \
    | sed -E 's#^https?://##; s#[:/].*$##' \
    || true)"
  if [ -n "$host" ]; then printf 'https://%s' "$host"; return; fi
  printf '%s' "$base"
}

# muxpad agent new [--workspace=<id>] [--cwd=<dir>] [--name=<tab name>] [--model=<model>] [--backend=<b>] "first message"
# One-shot launcher: creates an agent tab (chat-native Claude session), waits
# for its runner to register, sends the first message so the session starts
# processing immediately, and prints the tab's URL. The runner needs a couple
# of seconds to boot inside the fresh pane, so the send polls until accepted.
cmd_agent_new() {
  reset_flags workspace cwd name model mode backend
  parse_flags workspace cwd name model mode backend -- "$@"
  local message="${POSITIONAL[0]:-}"
  if [ -z "$message" ]; then
    echo 'usage: muxpad agent new [--workspace=<id>] [--cwd=<dir>] [--name=<tab name>] [--model=<model>] [--mode=chat|agent] [--backend=claude|codex|cursor|pick] "first message"' >&2
    exit 1
  fi
  # Agent mode (see agent-modes.ts): 'chat' overlays muxpad's terse, decisive
  # contract; 'agent' is the harness exactly as it ships. Omitted = the
  # server's default, which is 'chat' — a spawned worker is muxpad asking for
  # work to be done, not a harness someone sat down at.
  #
  # Validated HERE as well as server-side so a typo fails loudly instead of
  # silently spawning a worker in the wrong mode. The pre-rename 'do'/'deep'
  # still pass: this script and the server upgrade together, but a checked-out
  # older copy of it (or a script someone wrote against it) must not start
  # failing.
  case "${FLAG_mode:-chat}" in
    chat|agent|do|deep) ;;
    *) echo "muxpad: --mode must be 'chat' or 'agent' (got '$FLAG_mode')" >&2; exit 1 ;;
  esac
  # Which harness the worker runs. POST /api/tabs has always accepted this; the
  # CLI just never passed it, so every scripted spawn was a Claude one and
  # fleets of mixed harnesses had to be built by hand against the HTTP API.
  # Validated here for the same reason --mode is: a typo must fail loudly
  # rather than silently spawn the wrong harness.
  if [ -n "${FLAG_backend:-}" ]; then
    case "$FLAG_backend" in
      claude|codex|cursor|pick) ;;
      *) echo "muxpad: --backend must be claude, codex, cursor or pick (got '$FLAG_backend')" >&2; exit 1 ;;
    esac
  fi
  # WHERE THE WORKER LANDS. Two cases, and the first one is nearly every spawn.
  #
  # SPAWNED FROM INSIDE A PANE ($MUXPAD_PANE_ID) — the worker has a PARENT, and
  # the parent's workspace is the answer. The server resolves it from the live
  # row (see routes/tabs.ts), so this sends no workspace at all: not the flag,
  # and above all not $MUXPAD_WORKSPACE_ID, which is stamped into the pane's
  # environment at birth and is therefore a guess that goes stale the moment the
  # chat is moved. That stale guess is what kept re-seeding a workspace the user
  # had abandoned — every generation of agents carrying the same dead id.
  #
  # A ROOT spawn (no pane, e.g. a cron or a plain shell) keeps the old
  # behaviour: the flag, then the env, then a hard error.
  local workspace_id=''
  if [ -n "${MUXPAD_PANE_ID:-}" ]; then
    if [ -n "${FLAG_workspace:-}" ]; then
      # Ignored, not refused, and SAID OUT LOUD — a launcher that passed it was
      # working around exactly the bug this now fixes, and it must not silently
      # keep putting children somewhere other than their parent.
      echo "muxpad: --workspace is ignored for a spawn from inside a pane — the worker goes where its parent chat lives" >&2
    fi
  elif [ -n "${FLAG_workspace:-}" ]; then
    workspace_id="$FLAG_workspace"
  else
    workspace_id="${MUXPAD_WORKSPACE_ID:-}"
    if [ -z "$workspace_id" ]; then
      echo "muxpad: --workspace=<id> required (no parent pane and no MUXPAD_WORKSPACE_ID in env)" >&2
      exit 1
    fi
    # A pane living in a hidden system workspace inherits a hidden
    # MUXPAD_WORKSPACE_ID — a worker spawned there would be an invisible tab
    # no sidebar ever shows. Only the CLI knows the id was a
    # defaulted env value rather than an explicit --workspace, so the
    # fallback lives here, not on the server: delegation must just work,
    # while explicit targeting (even of a hidden workspace) stays untouched.
    local ws_all hidden
    ws_all="$(http_request GET '/api/workspaces?all=1')"
    hidden="$(printf '%s' "$ws_all" | jq -r --arg id "$workspace_id" \
      '[.[] | select(.id == $id)] | (.[0].hidden // false) | tostring')"
    if [ "$hidden" = "true" ]; then
      workspace_id="$(printf '%s' "$ws_all" | jq -r '[.[] | select(.hidden | not)][0].id // empty')"
      if [ -z "$workspace_id" ]; then
        echo "muxpad: current workspace is the hidden system workspace and no visible workspace exists — create one (muxpad workspace new) or pass --workspace=<id>" >&2
        exit 1
      fi
      echo "muxpad: current workspace is hidden — spawning the worker in the first visible workspace (pass --workspace=<id> to target another)" >&2
    fi
  fi
  local cwd="${FLAG_cwd:-$PWD}"
  local body
  body="{\"bootstrap\":\"agent\",\"cwd\":$(json_string "$cwd")"
  # Absent for a spawn with a parent — see "WHERE THE WORKER LANDS" above. The
  # server requires one only when there is no parent to inherit from.
  [ -n "$workspace_id" ] && body+=",\"workspace_id\":$(json_string "$workspace_id")"
  # A custom tab name survives the session's AI auto-rename (only the
  # bootstrap default 'agent' gets renamed) — so launchers can label the tab.
  [ -n "${FLAG_name:-}" ] && body+=",\"name\":$(json_string "$FLAG_name")"
  # Model rides the pane's startup command (`muxpad agent --model <m>`), so it
  # also survives ptyd restarts / resumes. Server-validated charset.
  [ -n "${FLAG_model:-}" ] && body+=",\"model\":$(json_string "$FLAG_model")"
  # Mode rides the pane row AND its startup command, so a respawn keeps it.
  [ -n "${FLAG_mode:-}" ] && body+=",\"mode\":$(json_string "$FLAG_mode")"
  # Backend rides the pane's startup command too (`muxpad agent --backend <b>`),
  # so a respawn keeps the harness it was launched with.
  [ -n "${FLAG_backend:-}" ] && body+=",\"backend\":$(json_string "$FLAG_backend")"
  # HIERARCHY. Spawned from inside a pane — which is nearly every scripted
  # spawn, since the caller is an agent delegating work — the new chat records
  # which chat asked for it. That is what makes it nest in the sidebar and
  # share its parent's decay clock, so a worker cannot outlive the chat it was
  # spawned to serve. The server resolves pane→tab and silently drops the link
  # if that tab is gone, so a spawn never fails over provenance.
  [ -n "${MUXPAD_PANE_ID:-}" ] && body+=",\"spawned_by_pane\":$(json_string "$MUXPAD_PANE_ID")"
  body+='}'
  local tab_json tab_id tab_slug
  tab_json="$(http_request POST /api/tabs "$body")"
  tab_id="$(printf '%s' "$tab_json" | jq -r '.id')"
  tab_slug="$(printf '%s' "$tab_json" | jq -r '.slug')"
  # WHERE IT ACTUALLY LANDED, from the server — not from what we asked for. For a
  # spawn we asked for nothing (the parent decides), so this is the only way to
  # know, and it is also the honest value for the URL when a flag was ignored.
  local landed
  landed="$(printf '%s' "$tab_json" | jq -r '.workspace_id // empty')"
  [ -n "$landed" ] && workspace_id="$landed"
  local pane_id
  pane_id="$(http_request GET "/api/tabs/$tab_id" | jq -r '.panes[0].id')"
  # Poll the send until the runner registers (409 + reason until then).
  # http_request exits on non-2xx, so drive curl directly here.
  local send_body status tmp deadline
  send_body="{\"text\":$(json_string "$message")}"
  tmp="$(mktemp)"
  deadline=$((SECONDS + 30))
  while :; do
    status="$(curl -sS -o "$tmp" -w '%{http_code}' \
      -X POST -H 'content-type: application/json' \
      --data "$send_body" \
      "${MUXPAD_API_URL%/}/api/agent-sessions/$pane_id/send" || echo 000)"
    [ "$status" = "202" ] && break
    if [ "$SECONDS" -ge "$deadline" ]; then
      {
        printf '%smuxpad: agent did not accept the message within 30s%s\n' "$C_RED" "$C_RESET"
        [ -s "$tmp" ] && jq -r '.reason // empty' "$tmp" 2>/dev/null
        printf 'the tab exists (%s) — send the message from its chat view\n' "$tab_id"
      } >&2
      rm -f "$tmp"
      exit 1
    fi
    sleep 0.5
  done
  rm -f "$tmp"
  # Compose a clickable URL (wildcard bind isn't connectable — show loopback).
  # ?all=1: an explicitly-targeted hidden workspace is filtered from the
  # default list, and a silent empty slug would break the printed URL.
  local ws_slug base url
  ws_slug="$(http_request GET '/api/workspaces?all=1' | jq -r --arg id "$workspace_id" '.[] | select(.id == $id) | .slug')"
  base="$(printable_base)"
  url="$base/w/${ws_slug:-$workspace_id}/t/$tab_slug"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '{"tab_id":%s,"pane_id":%s,"url":%s}\n' \
      "$(json_string "$tab_id")" "$(json_string "$pane_id")" "$(json_string "$url")"
  else
    printf '%s✓%s agent started, message sent\n' "$C_GREEN" "$C_RESET"
    printf '  %stab:%s  %s\n' "$C_DIM" "$C_RESET" "$tab_id"
    printf '  %spane:%s %s\n' "$C_DIM" "$C_RESET" "$pane_id"
    printf '  %surl:%s  %s\n' "$C_DIM" "$C_RESET" "$url"
  fi
}

# `muxpad agent list` — every tracked agent session across all panes.
cmd_agent_list() {
  local res
  res="$(http_request GET /api/agent-sessions)"
  # TURN, not STATUS. `agent_sessions.status` is running|idle — the session's
  # TURN state — and is a different vocabulary from the pane/tab/workspace
  # `status` (blocked|working|dead|ready|idle) the other list commands print.
  # Two meanings under one column header is how a supervisor misreads its own
  # org chart, so the narrower one gets the narrower name.
  print_table "$res" \
    'PANE:.pane_id' \
    'BACKEND:.assistant' \
    'MODE:(.mode // "agent")' \
    'TURN:.status' \
    'VIEW:.view_mode' \
    'SID:(.current_sid // "-")'
}

# `muxpad agent respawn <paneId>` | `--all [--backend=<id>]`
#
# Re-exec a pane's agent runner in place. The pane's startup_cmd carries
# `--resume <sid>`, so the session comes back from its transcript and the
# conversation continues; ptyd is never touched and no terminal dies.
#
# THE BULK FORM EXISTS BECAUSE A RECOVERY SHOULD BE ONE COMMAND. On 2026-09-20
# every Claude pane went dead at once (a token expiry racing 25 long-lived
# `claude` children) and the fix was a respawn of all 24. The obvious shell
# loop against the HTTP API — `for p in $(muxpad agent list | awk …)` — ate two
# attempts before anyone noticed the ids were dirty, and a hand-rolled loop
# also swallows per-pane failures. Both are handled here, once.
#
# The runner now self-heals that particular condition on its own (see
# server/src/agent-runner/auth-heal.ts). This stays as the escape hatch for
# everything it cannot: a wedged session, a runner that outlived a `pnpm build`,
# a pane whose SDK child is simply gone.
cmd_agent_respawn() {
  local a rest=() all=0
  for a in "$@"; do
    case "$a" in
      --all) all=1 ;;
      *) rest+=("$a") ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}
  reset_flags backend
  parse_flags backend -- "$@"
  require_api_url
  local backend="${FLAG_backend:-}"
  local ids=() id
  if [ "$all" = 1 ]; then
    require_jq
    if [ "${#POSITIONAL[@]}" -gt 0 ]; then
      echo 'muxpad: agent respawn takes a pane id OR --all, not both' >&2
      exit 1
    fi
    local res filter='.[]'
    res="$(http_request GET /api/agent-sessions)"
    if [ -n "$backend" ]; then
      filter=".[] | select(.assistant == $(json_string "$backend"))"
    fi
    while IFS= read -r id; do
      [ -n "$id" ] && ids+=("$id")
    done < <(printf '%s' "$res" | jq -r "$filter | .pane_id")
  else
    if [ -n "$backend" ]; then
      echo 'muxpad: --backend only makes sense with --all' >&2
      exit 1
    fi
    if [ "${#POSITIONAL[@]}" -ne 1 ]; then
      echo 'usage: muxpad agent respawn <paneId> | --all [--backend=<id>]' >&2
      exit 1
    fi
    ids=("${POSITIONAL[0]}")
  fi
  if [ "${#ids[@]}" -eq 0 ]; then
    printf '%s(none)%s\n' "$C_DIM" "$C_RESET"
    return 0
  fi
  local ok=0 bad=0 status
  for id in "${ids[@]}"; do
    # Scrub whitespace and control characters off the id before it becomes a
    # URL. A pane id pasted from a terminal carries the tty's CR (ONLCR turns
    # every \n into \r\n on the way out of a pty), and a CR inside a URL makes
    # curl fail with 000 and no message at all — which is exactly how two
    # recovery attempts were lost during the incident above.
    id="$(printf '%s' "$id" | tr -d '[:space:]')"
    [ -z "$id" ] && continue
    status="$(curl -sS -o /dev/null -w '%{http_code}' -X POST \
      "${MUXPAD_API_URL%/}/api/panes/$id/respawn" || echo 000)"
    case "$status" in
      2*)
        ok=$((ok + 1))
        printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$id"
        ;;
      *)
        bad=$((bad + 1))
        printf '%s✗%s %s %s(HTTP %s)%s\n' \
          "$C_RED" "$C_RESET" "$id" "$C_DIM" "$status" "$C_RESET" >&2
        ;;
    esac
  done
  if [ "$bad" -gt 0 ]; then
    printf '%s%d respawned, %d failed%s\n' "$C_DIM" "$ok" "$bad" "$C_RESET"
    exit 1
  fi
  printf '%s%d respawned%s\n' "$C_DIM" "$ok" "$C_RESET"
}

# `muxpad agent send <paneId> "message"` — deliver a message to the pane's
# agent runner via the server-side queue. Exit codes: 0 sent, 0 queued
# (behind an in-flight turn; noted on stderr), 1 rejected (reason printed).
cmd_agent_send() {
  reset_flags
  parse_flags -- "$@"
  if [ "${#POSITIONAL[@]}" -lt 2 ]; then
    echo 'usage: muxpad agent send <paneId> "message"' >&2
    exit 1
  fi
  require_api_url
  local pane_id="${POSITIONAL[0]}"
  local message="${POSITIONAL[1]}"
  # Drive curl directly (not http_request): a 409 rejection carries
  # {ok:false, reason} — we want the reason on stderr + exit 1, not the
  # generic HTTP-error dump.
  local tmp status
  tmp="$(mktemp)"
  status="$(curl -sS -o "$tmp" -w '%{http_code}' \
    -X POST -H 'content-type: application/json' \
    --data "{\"text\":$(json_string "$message")}" \
    "${MUXPAD_API_URL%/}/api/agent-sessions/$pane_id/send" || echo 000)"
  if [ "$status" = "202" ]; then
    local queued
    queued="$(jq -r '.queued // false' "$tmp" 2>/dev/null || echo false)"
    rm -f "$tmp"
    if [ "$queued" = "true" ]; then
      echo "muxpad: agent busy — message queued, will run after the current turn" >&2
    fi
    if [ "$JSON_OUTPUT" = "1" ]; then
      printf '{"ok":true,"queued":%s}\n' "$queued"
    else
      printf '%s✓%s message %s to %s\n' "$C_GREEN" "$C_RESET" \
        "$([ "$queued" = "true" ] && echo queued || echo sent)" "$pane_id"
    fi
    return 0
  fi
  local reason
  reason="$(jq -r '.reason // empty' "$tmp" 2>/dev/null || true)"
  rm -f "$tmp"
  printf '%smuxpad: agent send rejected (HTTP %s)%s%s\n' \
    "$C_RED" "$status" "${reason:+ — $reason}" "$C_RESET" >&2
  exit 1
}

# `muxpad agent transcript <paneId> [--tail=N]` — last N normalized transcript
# events as JSONL (role, text, tool-use summaries), whatever the backend.
cmd_agent_transcript() {
  reset_flags tail
  parse_flags tail -- "$@"
  local pane_id="${POSITIONAL[0]:-}"
  if [ -z "$pane_id" ]; then
    echo 'usage: muxpad agent transcript <paneId> [--tail=N]' >&2
    exit 1
  fi
  local qs=''
  [ -n "${FLAG_tail:-}" ] && qs="?tail=$FLAG_tail"
  http_request GET "/api/agent-sessions/$pane_id/transcript$qs"
}

# `muxpad agent wait <paneId> [--timeout=SEC]` — block until the pane's agent
# finishes its turn: the orchestration workhorse (run it in the background via
# Bash and get re-invoked when a worker finishes — tokenless waiting).
# Exit codes: 0 turn done (or agent already idle), 2 the pane's runner
# reported fatal, 3 --timeout elapsed, 1 plumbing failure (stream died, pane
# has no agent session).
#
# Idle detection reads `turn_active` from GET /api/agent-sessions/by-pane —
# the runner registry's REAL turn state. Deliberately not the pane `busy`
# flag: busy also trips on raw pty output activity, so a worker whose
# terminal streams (dev-server logs) would read busy forever and the wait
# would never take its already-idle exit. A pane with no agent session at
# all is an error (exit 1), not "already idle".
#
# Race-free by ordering: SUBSCRIBE FIRST (the server writes its `: connected`
# handshake only after our bus subscription is registered), and only then read
# the pane's current turn state — a turn that ends between the check and the
# subscription is impossible; one that ended before the check reads as idle.
cmd_agent_wait() {
  reset_flags timeout
  parse_flags timeout -- "$@"
  local pane_id="${POSITIONAL[0]:-}"
  if [ -z "$pane_id" ]; then
    echo 'usage: muxpad agent wait <paneId> [--timeout=SEC]' >&2
    exit 1
  fi
  require_api_url
  local timeout="${FLAG_timeout:-}"
  if [ -n "$timeout" ] && ! [[ "$timeout" =~ ^[0-9]+$ ]]; then
    echo "muxpad: --timeout must be a whole number of seconds (got '$timeout')" >&2
    exit 1
  fi
  local tmpdir fifo curl_pid=''
  tmpdir="$(mktemp -d)"
  fifo="$tmpdir/events"
  mkfifo "$fifo"
  # shellcheck disable=SC2064  # expand tmpdir now; curl_pid is late-bound
  trap "kill \"\$curl_pid\" 2>/dev/null; rm -rf '$tmpdir'" EXIT
  # An untrapped INT/TERM kills the shell WITHOUT running the EXIT trap —
  # the fifo/tmpdir would leak. Convert signals into an exit, which fires it.
  trap 'exit 130' INT
  trap 'exit 143' TERM
  # 1. Subscribe FIRST. The fifo write-open and our read-open rendezvous,
  #    so no events are lost between curl starting and us reading.
  curl -sN "${MUXPAD_API_URL%/}/api/events?types=agent_turn" > "$fifo" &
  curl_pid=$!
  # Detach from job control so the EXIT-trap kill doesn't print a
  # "Terminated" job notice over our own output.
  disown "$curl_pid" 2>/dev/null || true
  exec 3< "$fifo"
  local deadline='' checked=0 line payload phase rc
  [ -n "$timeout" ] && deadline=$((SECONDS + timeout))
  while :; do
    rc=0
    if [ -n "$deadline" ]; then
      local remaining=$((deadline - SECONDS))
      [ "$remaining" -le 0 ] && exit 3
      IFS= read -r -t "$remaining" line <&3 || rc=$?
    else
      IFS= read -r line <&3 || rc=$?
    fi
    if [ "$rc" -ne 0 ]; then
      # `read -t` reports timeout as >128 on bash 4+, but as plain 1 on the
      # macOS stock bash 3.2 — the deadline is the portable signal.
      if [ -n "$deadline" ] && [ "$SECONDS" -ge "$deadline" ]; then
        echo "muxpad: timed out after ${timeout}s waiting on $pane_id" >&2
        exit 3
      fi
      [ "$rc" -gt 128 ] && exit 3 # read timed out (racing the deadline)
      echo "muxpad: event stream closed — is the daemon up at $MUXPAD_API_URL?" >&2
      exit 1
    fi
    # An event line may beat the busy check below (it fired between the
    # server subscribing us and us checking) — handle it first, never drop it.
    case "$line" in
      data:*)
        payload="${line#data:}"
        payload="${payload# }"
        phase="$(printf '%s' "$payload" | jq -r --arg id "$pane_id" \
          'select(.type == "agent_turn" and .pane_id == $id) | .phase' 2>/dev/null || true)"
        case "$phase" in
          done)
            if [ "$JSON_OUTPUT" = "1" ]; then
              printf '{"pane_id":%s,"result":"done"}\n' "$(json_string "$pane_id")"
            else
              printf '%s✓%s agent turn done (%s)\n' "$C_GREEN" "$C_RESET" "$pane_id"
            fi
            exit 0
            ;;
          fatal)
            echo "muxpad: agent in pane $pane_id reported fatal" >&2
            exit 2
            ;;
        esac
        ;;
    esac
    # 2. First line from the server = subscription confirmed → NOW read the
    #    current turn state once. Already idle (or between turns) returns
    #    immediately; from here on the stream alone decides.
    if [ "$checked" = "0" ]; then
      checked=1
      local state_tmp state_status turn
      state_tmp="$tmpdir/state"
      state_status="$(curl -sS -o "$state_tmp" -w '%{http_code}' \
        "${MUXPAD_API_URL%/}/api/agent-sessions/by-pane/$pane_id" || echo 000)"
      if [ "$state_status" = "404" ]; then
        echo "muxpad: no agent session for pane $pane_id — agent wait only works on agent panes" >&2
        exit 1
      fi
      if [ "$state_status" != "200" ]; then
        echo "muxpad: could not read agent state for $pane_id (HTTP $state_status)" >&2
        exit 1
      fi
      # turn_active is the runner's real turn state (never pty `busy`).
      turn="$(jq -r '.turn_active // false | tostring' "$state_tmp" 2>/dev/null || echo false)"
      if [ "$turn" != "true" ]; then
        if [ "$JSON_OUTPUT" = "1" ]; then
          printf '{"pane_id":%s,"result":"idle"}\n' "$(json_string "$pane_id")"
        else
          printf '%s✓%s agent already idle (%s)\n' "$C_GREEN" "$C_RESET" "$pane_id"
        fi
        exit 0
      fi
    fi
  done
}

cmd_agent() {
  # `muxpad agent new|list|respawn|send|transcript|wait …` are HTTP verbs;
  # anything else is the in-pane runner itself (including the server-written
  # `muxpad agent --resume <sid>`).
  case "${1:-}" in
    new) shift; cmd_agent_new "$@"; return ;;
    list) shift; require_jq; cmd_agent_list "$@"; return ;;
    respawn) shift; cmd_agent_respawn "$@"; return ;;
    send) shift; require_jq; cmd_agent_send "$@"; return ;;
    transcript) shift; require_jq; cmd_agent_transcript "$@"; return ;;
    wait) shift; require_jq; cmd_agent_wait "$@"; return ;;
  esac
  local runner="$ROOT/server/dist/agent-runner/index.js" a
  # `--help` is answered BEFORE the pane check, by the runner itself (one usage
  # text, in server/src/agent-runner/args.ts). Asking a subcommand what it does
  # is a reflex — and the reflex answer here used to be "must be run inside a
  # muxpad pane", which teaches nothing and is what sent someone to type the
  # bare command in a pane that already had a session (see args.ts).
  for a in "$@"; do
    case "$a" in
      --help|-h)
        if [ -f "$runner" ]; then exec node "$runner" --help; fi
        echo "muxpad agent: runner not built ($runner missing) — run 'pnpm build' in $ROOT" >&2
        exit 1 ;;
    esac
  done
  if [ -z "${MUXPAD_PANE_ID:-}" ]; then
    echo "muxpad agent: must be run inside a muxpad pane (no MUXPAD_PANE_ID)" >&2
    exit 1
  fi
  if [ ! -f "$runner" ]; then
    echo "muxpad agent: runner not built ($runner missing) — run 'pnpm build' in $ROOT" >&2
    exit 1
  fi
  exec node "$runner" "$@"
}


# ─── cron ──────────────────────────────────────────────────────────────────
# `muxpad cron` — durable, server-owned schedules
# (docs/plans/2026-08-14-muxpad-cron.md). Unlike a harness's built-in cron,
# these survive restarts, catch up after downtime, never expire, are visible
# from anywhere, and can be fired by hand before you trust them.

# Resolve a --pane value to a pane id. Accepts an id verbatim, the pane's
# `name`, or empty (= this pane, $MUXPAD_PANE_ID) — typing a ulid is miserable,
# and the natural gesture is running `muxpad cron new` from inside the pane you
# mean.
cron_resolve_pane() {
  local ref="$1"
  if [ -z "$ref" ]; then
    if [ -z "${MUXPAD_PANE_ID:-}" ]; then
      echo "muxpad: --pane with no value means THIS pane, but MUXPAD_PANE_ID is unset (not inside a muxpad pane)" >&2
      exit 1
    fi
    printf '%s' "$MUXPAD_PANE_ID"
    return
  fi
  local panes match
  panes="$(http_request GET /api/panes)"
  match="$(printf '%s' "$panes" | jq -r --arg r "$ref" \
    '[.[] | select(.id == $r)] | .[0].id // empty')"
  if [ -z "$match" ]; then
    match="$(printf '%s' "$panes" | jq -r --arg r "$ref" \
      '[.[] | select((.name // "") == $r)] | .[0].id // empty')"
  fi
  if [ -z "$match" ]; then
    echo "muxpad: no pane with id or name '$ref' (try: muxpad pane list --all)" >&2
    exit 1
  fi
  printf '%s' "$match"
}

cmd_cron_new() {
  # `--pane` and `--new-tab` are BARE mode flags (parse_flags would eat the
  # next argument as their value), so pre-strip them the way cmd_search does
  # with --sessions. `--pane=<id|name>` still comes through parse_flags.
  # Pre-strip the flags parse_flags can't take: BARE mode flags (it would eat
  # the next argument as their value) and hyphenated names (it evals
  # FLAG_<name>=, and `FLAG_on-context` is not a legal shell variable).
  local a rest=() target='' pane_ref='' close_flag='' on_context='' max_open=''
  for a in "$@"; do
    case "$a" in
      --pane) target=pane ;;
      --pane=*) target=pane; pane_ref="${a#--pane=}" ;;
      --new-tab) target=new-tab ;;
      --no-close) close_flag=false ;;
      --close) close_flag=true ;;
      --on-context=*) on_context="${a#--on-context=}" ;;
      --max-open=*) max_open="${a#--max-open=}" ;;
      *) rest+=("$a") ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}
  reset_flags name at tz workspace cwd model backend mode catchup overlap quiet
  parse_flags name at tz workspace cwd model backend mode catchup overlap quiet -- "$@"
  local prompt="${POSITIONAL[0]:-}"
  if [ -z "$target" ] || [ -z "${FLAG_at:-}" ] || [ -z "$prompt" ]; then
    cat >&2 <<'USAGE'
usage: muxpad cron new --name=<name> --at='<cron expr | daily at 09:00 | every 30m>'
         (--pane[=<id|name>] | --new-tab [--workspace=<id>])
         [--tz=America/Los_Angeles] [--cwd=<dir>] [--model=<m>] [--backend=claude|codex|cursor]
         [--mode=chat|agent] [--catchup=once|skip|all] [--overlap=skip|queue]
         [--on-context=fire|compact-first|rotate|skip] [--quiet=<mins>]
         [--max-open=<n>] [--no-close] "prompt"

  --pane with no value targets THIS pane ($MUXPAD_PANE_ID) — the usual gesture.
  --new-tab spawns a fresh agent tab per fire (clean context, no drift) and
  closes it when the run finishes cleanly; --no-close keeps it.
USAGE
    exit 1
  fi
  local name="${FLAG_name:-}"
  if [ -z "$name" ]; then
    echo "muxpad: --name=<name> required" >&2
    exit 1
  fi
  local body
  body="{\"name\":$(json_string "$name"),\"schedule\":$(json_string "$FLAG_at"),\"prompt\":$(json_string "$prompt")"
  if [ "$target" = "pane" ]; then
    local pane_id
    pane_id="$(cron_resolve_pane "$pane_ref")"
    body+=",\"target_kind\":\"pane\",\"target_pane\":$(json_string "$pane_id")"
  else
    local workspace_id="${FLAG_workspace:-${MUXPAD_WORKSPACE_ID:-}}"
    if [ -z "$workspace_id" ]; then
      echo "muxpad: --workspace=<id> required for --new-tab (no MUXPAD_WORKSPACE_ID in env)" >&2
      exit 1
    fi
    body+=",\"target_kind\":\"new-tab\",\"workspace_id\":$(json_string "$workspace_id")"
    body+=",\"cwd\":$(json_string "${FLAG_cwd:-$PWD}")"
  fi
  [ -n "${FLAG_tz:-}" ] && body+=",\"tz\":$(json_string "$FLAG_tz")"
  [ -n "${FLAG_model:-}" ] && body+=",\"model\":$(json_string "$FLAG_model")"
  [ -n "${FLAG_backend:-}" ] && body+=",\"backend\":$(json_string "$FLAG_backend")"
  [ -n "${FLAG_mode:-}" ] && body+=",\"mode\":$(json_string "$FLAG_mode")"
  [ -n "${FLAG_catchup:-}" ] && body+=",\"catchup\":$(json_string "$FLAG_catchup")"
  [ -n "${FLAG_overlap:-}" ] && body+=",\"overlap\":$(json_string "$FLAG_overlap")"
  [ -n "$on_context" ] && body+=",\"on_context\":$(json_string "$on_context")"
  # Numeric fields go in unquoted — validate here so a typo is a CLI error
  # rather than a 400 from the server.
  if [ -n "${FLAG_quiet:-}" ]; then
    case "$FLAG_quiet" in (*[!0-9]*|'') echo "muxpad: --quiet must be a whole number of minutes" >&2; exit 1 ;; esac
    body+=",\"quiet_mins\":$FLAG_quiet"
  fi
  if [ -n "$max_open" ]; then
    case "$max_open" in (*[!0-9]*|'') echo "muxpad: --max-open must be a whole number" >&2; exit 1 ;; esac
    body+=",\"max_open\":$max_open"
  fi
  [ -n "$close_flag" ] && body+=",\"close_when_done\":$close_flag"
  body+='}'
  local res
  res="$(http_request POST /api/crons "$body")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
    return
  fi
  printf '%s✓%s cron created\n' "$C_GREEN" "$C_RESET"
  printf '  %sid:%s       %s\n' "$C_DIM" "$C_RESET" "$(printf '%s' "$res" | jq -r '.id')"
  printf '  %sschedule:%s %s (%s)\n' "$C_DIM" "$C_RESET" \
    "$(printf '%s' "$res" | jq -r '.schedule')" "$(printf '%s' "$res" | jq -r '.tz')"
  printf '  %snext:%s     %s\n' "$C_DIM" "$C_RESET" \
    "$(printf '%s' "$res" | jq -r '.next_due_at | (. / 1000 | strflocaltime("%a %d %b %H:%M"))')"
  printf '  %stest it:%s  muxpad cron run %s\n' "$C_DIM" "$C_RESET" "$name"
}

cmd_cron_list() {
  local res
  res="$(http_request GET /api/crons)"
  print_table "$res" \
    'NAME:.name' \
    'SCHEDULE:.schedule' \
    'TZ:.tz' \
    'TARGET:(if .target_kind == "pane" then "pane " + (.target_pane // "?") else "new-tab" end)' \
    'ON:(if .enabled then "yes" else "no" end)' \
    'NEXT:(.next_due_at / 1000 | strflocaltime("%a %d %b %H:%M"))' \
    'LAST:(if .last_fire_at then (.last_fire_at / 1000 | strflocaltime("%d %b %H:%M")) else "-" end)' \
    'STATUS:(.last_status // "-")' \
    'FAILS:(.fail_streak | tostring)' \
    'ID:.id'
}

cmd_cron_show() {
  local ref="${1:-}"
  if [ -z "$ref" ]; then
    echo 'usage: muxpad cron show <id|name>' >&2
    exit 1
  fi
  local res
  res="$(http_request GET "/api/crons/$ref")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
    return
  fi
  printf '%s' "$res" | jq -r '
    "name:      \(.name)",
    "id:        \(.id)",
    "schedule:  \(.schedule)  (\(.tz))",
    "target:    \(if .target_kind == "pane" then "pane " + (.target_pane // "?") else "new-tab in workspace " + (.workspace_id // "?") end)",
    "enabled:   \(.enabled)",
    "policies:  catchup=\(.catchup) overlap=\(.overlap) on_context=\(.on_context) quiet=\(.quiet_mins)m" +
      (if .target_kind == "new-tab" then " max_open=\(.max_open) close_when_done=\(.close_when_done)" else "" end),
    "next due:  \(.next_due_at / 1000 | strflocaltime("%a %d %b %Y %H:%M"))",
    "last:      \(if .last_fire_at then (.last_fire_at / 1000 | strflocaltime("%a %d %b %H:%M")) + "  " + (.last_status // "") else "never" end)",
    "fails:     \(.fail_streak)",
    "",
    "prompt:",
    (.prompt | split("\n") | map("  " + .) | join("\n")),
    "",
    "runs:"'
  printf '%s' "$res" | jq -r '.runs // [] |
    if length == 0 then "  (none yet)"
    else .[] | "  \(.fired_at / 1000 | strflocaltime("%d %b %H:%M"))  \(.outcome)\(if .detail then "  — " + .detail else "" end)"
    end'
}

cmd_cron_run() {
  local ref="${1:-}"
  if [ -z "$ref" ]; then
    echo 'usage: muxpad cron run <id|name>' >&2
    exit 1
  fi
  local res
  res="$(http_request POST "/api/crons/$ref/run" '{}')"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
    return
  fi
  local outcome detail
  outcome="$(printf '%s' "$res" | jq -r '.outcome // "?"')"
  detail="$(printf '%s' "$res" | jq -r '.detail // empty')"
  case "$outcome" in
    sent|queued)
      printf '%s✓%s fired — %s%s\n' "$C_GREEN" "$C_RESET" "$outcome" "${detail:+ ($detail)}"
      ;;
    *)
      printf '%s✗%s not delivered — %s%s\n' "$C_RED" "$C_RESET" "$outcome" "${detail:+ ($detail)}" >&2
      exit 1
      ;;
  esac
}

cron_set_enabled() {
  local ref="$1" enabled="$2" verb="$3"
  if [ -z "$ref" ]; then
    echo "usage: muxpad cron $verb <id|name>" >&2
    exit 1
  fi
  local res
  res="$(http_request PATCH "/api/crons/$ref" "{\"enabled\":$enabled}")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
    return
  fi
  local cron_name state
  cron_name="$(printf '%s' "$res" | jq -r '.name')"
  if [ "$enabled" = true ]; then
    state="resumed — next $(printf '%s' "$res" | jq -r '.next_due_at / 1000 | strflocaltime("%a %d %b %H:%M")')"
  else
    state='paused'
  fi
  printf '%s✓%s %s %s\n' "$C_GREEN" "$C_RESET" "$cron_name" "$state"
}

cmd_cron_rm() {
  local ref="${1:-}"
  if [ -z "$ref" ]; then
    echo 'usage: muxpad cron rm <id|name>' >&2
    exit 1
  fi
  http_request DELETE "/api/crons/$ref" >/dev/null
  printf '%s✓%s cron %s removed\n' "$C_GREEN" "$C_RESET" "$ref"
}

cmd_cron() {
  require_jq
  case "${1:-}" in
    new) shift; cmd_cron_new "$@" ;;
    list|ls) shift; cmd_cron_list "$@" ;;
    show) shift; cmd_cron_show "$@" ;;
    run) shift; cmd_cron_run "$@" ;;
    pause) shift; cron_set_enabled "${1:-}" false pause ;;
    resume) shift; cron_set_enabled "${1:-}" true resume ;;
    rm|delete) shift; cmd_cron_rm "$@" ;;
    *)
      cat >&2 <<'USAGE'
usage: muxpad cron <command>

  new     create a schedule (see `muxpad cron new` for flags)
  list    every schedule: target, next due, last run, failure streak
  show    one schedule in full, with its run history
  run     fire it NOW — test it before you trust it
  pause   stop firing (keeps the schedule)
  resume  start firing again, re-anchored to the next slot
  rm      delete it
USAGE
      exit 1
      ;;
  esac
}

# `muxpad search "query" [--limit=N]` — full-text search across every
# archived agent session (the muxpad-owned raw transcript mirrors, see
# docs/plans/2026-08-28-session-archive.md). The query is a raw FTS5 MATCH
# expression (AND/OR/NEAR/"phrases"); a syntax error server-side falls back
# to a plain phrase match. `muxpad search --sessions [--cwd=X]` lists the
# archived sessions instead.
cmd_search() {
  # `--sessions` is a bare mode flag, not a --key=value pair — pre-strip it.
  local mode=search
  local rest=()
  for a in "$@"; do
    case "$a" in
      --sessions) mode=sessions ;;
      *) rest+=("$a") ;;
    esac
  done
  if [ "$mode" = "sessions" ]; then
    reset_flags cwd limit
    parse_flags cwd limit -- "${rest[@]+"${rest[@]}"}"
    local qs="?limit=${FLAG_limit:-100}"
    [ -n "$FLAG_cwd" ] && qs="$qs&cwd=$(jq -rn --arg v "$FLAG_cwd" '$v|@uri')"
    local res
    res="$(http_request GET "/api/archive/sessions$qs")"
    if [ "$JSON_OUTPUT" = "1" ]; then
      printf '%s\n' "$res"
      return
    fi
    print_table "$(printf '%s' "$res" | jq '.sessions')" \
      'SID:.sid' \
      'BACKEND:(.assistant // "-")' \
      'PANE:(.pane_id // "-")' \
      'CWD:(.cwd // "-")' \
      'LAST:(if .last_ts then (.last_ts / 1000 | strflocaltime("%Y-%m-%d %H:%M")) else "-" end)'
    return
  fi
  reset_flags limit sid role
  parse_flags limit sid role -- "${rest[@]+"${rest[@]}"}"
  local query="${POSITIONAL[0]:-}"
  if [ -z "$query" ]; then
    echo 'usage: muxpad search "query" [--limit=N] [--sid=SID] [--role=ROLE] | muxpad search --sessions [--cwd=X]' >&2
    exit 1
  fi
  # Mirror the server's 1 KiB cap client-side: FTS5 evaluates the expression
  # synchronously and a huge one freezes the server's main thread.
  if [ "${#query}" -gt 1024 ]; then
    echo 'muxpad: search query too long (max 1024 bytes)' >&2
    exit 1
  fi
  local qs="?q=$(jq -rn --arg v "$query" '$v|@uri')&limit=${FLAG_limit:-20}"
  [ -n "$FLAG_sid" ] && qs="$qs&sid=$(jq -rn --arg v "$FLAG_sid" '$v|@uri')"
  [ -n "$FLAG_role" ] && qs="$qs&role=$(jq -rn --arg v "$FLAG_role" '$v|@uri')"
  local res
  res="$(http_request GET "/api/search$qs")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
    return
  fi
  if [ "$(printf '%s' "$res" | jq '.hits | length')" = "0" ]; then
    echo "no matches"
    return
  fi
  # One block per hit: snippet, then dim provenance line.
  printf '%s' "$res" | jq -r '.hits[] | [
      (.snippet | gsub("[\n\t]+"; " ")),
      (.sid + "  " + .role
        + (if .ts then "  " + (.ts / 1000 | strflocaltime("%Y-%m-%d %H:%M")) else "" end)
        + (if .session.cwd then "  " + .session.cwd else "" end))
    ] | @tsv' |
    while IFS=$'\t' read -r snippet prov; do
      printf '%s\n' "$snippet"
      printf '  %s%s%s\n' "$C_DIM" "$prov" "$C_RESET"
    done
}

# ─── publish ────────────────────────────────────────────────────────────────
# Host a file or directory at a PUBLIC internet URL (Tailscale Funnel → the
# dedicated public static port). The URL is the one thing printed on stdout,
# so `url=$(muxpad publish report.html)` just works; warnings go to stderr.

# Locate the tailscale binary. THE POLICY LIVES IN server/src/tailscale-bin.ts
# — this is its shell twin, and tailscale-bin.test.ts asserts the two still
# agree (via the `_tailscale-bin` verb below). Read that file before changing
# either. In short: MUXPAD_TAILSCALE_BIN (exclusive — a missing override
# resolves to NOTHING, never to the app bundle, so tests can never exec the
# real binary) > PATH > /Applications/Tailscale.app.
#
# Prints the path, or nothing when unavailable. Always exits 0.
find_tailscale() {
  if [ -n "${MUXPAD_TAILSCALE_BIN:-}" ]; then
    [ -x "$MUXPAD_TAILSCALE_BIN" ] && echo "$MUXPAD_TAILSCALE_BIN"
    return 0
  fi
  if command -v tailscale >/dev/null 2>&1; then
    echo tailscale
    return 0
  fi
  if [ -x "/Applications/Tailscale.app/Contents/MacOS/Tailscale" ]; then
    echo "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
  fi
  return 0
}

# Best-effort public-base-url discovery from THIS shell. The daemon runs under
# launchd, where the macOS Tailscale app CLI refuses to run (CLIError 3) — but
# it works fine from user/pane shells. So the CLI ensures the funnel and reads
# Self.DNSName here, and hands the server a `public_base_url` hint to persist.
# EVERY failure is silent (empty output): the server's fallback chain (persisted
# globals → local URL + warning) copes without us.
#
# ASK FIRST. This function used to run unconditionally on every `muxpad
# publish`, and on a Mac with no `tailscale` on PATH that means executing the
# binary inside /Applications/Tailscale.app — which reads that app's container,
# so macOS puts up "node would like to access data from other apps". Every
# publish, several times a day.
#
# The hint is only worth anything when the server does not already know a base,
# and the server is the only one who can say (public-base.ts: env > pinned >
# tunnel > hint > funnel > persisted). On this machine it holds a live tunnel
# AND the persisted ts.net name, so the discovered hint was ranked below both
# and thrown away — a modal dialog per publish for a value nobody used.
#
# `discovery_needed` also stays false after a FAILED attempt for
# DISCOVERY_RETRY_TTL_MS, so a machine with no tailnet asks at most once a
# working day rather than once a command. A server too old to send the field, or
# unreachable, yields empty → we discover, i.e. the old behaviour.
# This machine's tailnet FQDN, WITHOUT touching Tailscale. Prints the name or
# nothing; never fails.
#
# Tailscale here is a Mac App Store install: the only CLI is inside the sandboxed
# /Applications/Tailscale.app, there will be no `brew install`, and every exec of
# that binary reads the app's own container — which is what makes macOS ask "node
# would like to access data from other apps". So the name has to come from
# somewhere else, and it does, twice over:
#
#   1. tailscaled puts this host's address in 100.64.0.0/10 (CGNAT) on a utun
#      interface. `ifconfig` reads interface config — not privileged, no prompt.
#   2. MagicDNS answers that address's PTR with the full name (macOS's
#      /etc/resolv.conf lists `nameserver 100.100.100.100`), so a plain reverse
#      lookup resolves it — again no prompt.
#
# Verified: 100.111.22.33 → dt-mac-mini.example-tailnet.ts.net, which is exactly the
# base already persisted in globals.
#
# NOT `scutil --get LocalHostName`, though it is equally prompt-free: on this
# machine it answers `home` while the tailnet name is `dt-mac-mini`. They are
# unrelated settings, so gluing LocalHostName to the tailnet suffix would produce
# `home.example-tailnet.ts.net` — a wrong host and a link that cannot work. The PTR is
# the machine's real tailnet identity, not a guess assembled from parts.
#
# The TS twin is server/src/tailnet-hostname.ts; keep the two in step.
tailnet_hostname() {
  local ip name
  # 100.64–100.127 only. 100.5.x and 100.200.x are ORDINARY public addresses, and
  # treating all of 100/8 as tailnet would reverse-resolve a stranger's host and
  # then trust the name that came back.
  ip="$(ifconfig 2>/dev/null \
    | grep -oE 'inet 100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+' \
    | awk '{print $2}' | head -1 || true)"
  [ -z "$ip" ] && return 0
  name="$(dig +short +time=2 +tries=1 -x "$ip" 2>/dev/null | head -1 | sed 's/\.*$//' || true)"
  # Only a *.ts.net answer is believed. Anything else means MagicDNS is off or
  # something else on the network answered the PTR for CGNAT space, and a name
  # from there would build a dead link. `*.ts.net` (not a substring match), so
  # `ts.net.attacker.example` and a bare `ts.net` are both refused.
  case "$name" in
    *.ts.net) printf '%s' "$name" ;;
  esac
  return 0
}

# Say it, when the link being handed over will not keep.
#
# THE DEFECT THIS CLOSES. `muxpad publish` printed a URL on stdout and nothing
# else. On this machine that URL is a Cloudflare QUICK tunnel, whose hostname is
# randomly reassigned every time the tunnel restarts — so every link printed
# between 2026-09-19 and 2026-09-27 died together at 19:45 on the 27th, when a
# ptyd restart rebuilt the tunnel pane. Nothing crashed and nothing was
# misconfigured; that cloudflared ran eight days and exited zero times. The
# links were simply handed out as permanent when they were not.
#
# STDERR, never stdout. `muxpad publish` documents stdout as JUST the url so it
# can be piped, and a caveat that breaks `$(muxpad publish …)` would be a worse
# bug than the one it warns about.
base_note_line() {
  local json="${1:-}" note
  [ -z "$json" ] && return 0
  note="$(printf '%s' "$json" | jq -r '.note // empty' 2>/dev/null || true)"
  [ -z "$note" ] && return 0
  printf '%smuxpad: %s%s\n' "$C_DIM" "$note" "$C_RESET" >&2
  return 0
}

publish_base_url() {
  # probe=0: this is a pure DB question, and the probing variant walks every
  # candidate at up to 2.5s each — a dead tunnel would blow the 2s budget below,
  # leaving us to exec tailscale exactly when things are already wrong.
  #
  # The trailing `|| true` is NOT decoration. This script runs `set -euo
  # pipefail`, so a curl that fails or times out makes the whole assignment
  # non-zero and `set -e` tears the script down — a slow server would abort the
  # publish instead of merely leaving this question unanswered. An unanswered
  # question means "assume yes", i.e. the pre-existing behaviour.
  local needed
  needed="$(curl -sS --max-time 2 "${MUXPAD_API_URL%/}/api/publish/base?probe=0" 2>/dev/null \
    | jq -r 'if .discovery_needed == null then "" else (.discovery_needed | tostring) end' 2>/dev/null \
    || true)"
  [ "$needed" = "false" ] && return 0

  # COLD CACHE, AND STILL NO EXEC. The tailnet name is derivable from this
  # machine's own address (see tailnet_hostname above) — the same answer
  # `tailscale status --json` would give, for no prompt. So a first publish on a
  # fresh machine works without ever opening the app bundle.
  local host
  host="$(tailnet_hostname)"
  if [ -n "$host" ]; then printf 'https://%s:8443' "$host"; return 0; fi

  # LAST RESORT, and the only tier that costs a prompt. Reached only when the
  # server knows no base AND this machine has no tailnet address to reverse —
  # i.e. Tailscale is not up, in which case the exec will most likely fail too.
  # It is kept because it is also the only way to CREATE the funnel mapping
  # rather than merely name it; the server rations it to once per
  # DISCOVERY_RETRY_TTL_MS via `discovery_needed` above.
  local ts dns
  ts="$(find_tailscale)"
  [ -z "$ts" ] && return 0
  local pport="${MUXPAD_PUBLIC_PORT:-7778}"
  # Idempotent on tailscaled's side; re-running with the same mapping no-ops.
  "$ts" funnel --bg --https=8443 "http://127.0.0.1:$pport" >/dev/null 2>&1 || true
  dns="$("$ts" status --json 2>/dev/null | jq -r '.Self.DNSName // empty' 2>/dev/null | sed 's/\.*$//')" || true
  [ -n "$dns" ] && printf 'https://%s:8443' "$dns"
  return 0
}

cmd_publish() {
  # Bare mode flags (like `search --sessions`) — pre-strip them.
  # Bare mode flags AND the hyphenated `--set-base` are pre-stripped: parse_flags
  # eval-assigns `FLAG_<name>`, and `FLAG_set-base` is not a legal shell
  # identifier — `reset_flags` fails outright on it, taking every `publish`
  # invocation down with it. Same trap the cron verbs pre-strip around.
  local mode=publish
  local rest=()
  local set_base=''
  local want_url=''
  # WHO THE LINK IS FOR, and the default is the whole fix.
  #
  # Every artifact link handed out before this defaulted to the Cloudflare quick
  # tunnel, whose hostname Cloudflare reassigns on every restart — so the link
  # printed here worked when it was printed and was NXDOMAIN within hours. At
  # least six went dead in one afternoon on 2026-09-28.
  #
  # These artifacts are read on the author's own laptop and phone, and both are
  # tailnet nodes, where `https://<host>.ts.net:8443` is permanent and needs
  # nothing installed. So that is the default, and `--public` is how you ask for
  # a link you can send to somebody else — with its shelf life stated.
  local audience=''
  local a
  while [ $# -gt 0 ]; do
    a="$1"
    case "$a" in
      --public) audience=public ;;
      --list) mode=list ;;
      --base) mode=base ;;
      --clear-base) mode=clear-base ;;
      # `--url <slug-or-dead-link>` — REPRINT a live link for something already
      # published. The recovery path for the failure that motivated it: a
      # Cloudflare quick tunnel's hostname is randomly reassigned on every
      # restart, so every link handed out under the old name goes NXDOMAIN at
      # once, permanently. The BYTES are untouched — they are a directory under
      # `<dataDir>/public/<slug>` and the slug never changes — so the dead link
      # is not lost information, it is a stale prefix on a live slug.
      #
      # Takes a whole dead URL as well as a bare slug, because that is the form
      # the user actually has: it is sitting in a chat log or a report, and
      # asking them to parse the slug out of it by hand is asking them to do the
      # one mechanical step a script is for.
      --url=*) mode=url; want_url="${a#--url=}" ;;
      --url)
        shift
        want_url="${1:-}"
        [ -z "$want_url" ] && { echo 'muxpad publish: --url requires a slug or a dead link' >&2; exit 1; }
        mode=url
        ;;
      --set-base=*) set_base="${a#--set-base=}" ;;
      --set-base)
        shift
        set_base="${1:-}"
        [ -z "$set_base" ] && { echo 'muxpad publish: --set-base requires a url' >&2; exit 1; }
        ;;
      *) rest+=("$a") ;;
    esac
    shift
  done
  reset_flags name rm update
  parse_flags name rm update -- "${rest[@]+"${rest[@]}"}"

  # Query suffix for the read paths. Empty when nothing was asked for, so the
  # server's own default — the durable base — is what answers.
  local aq=''
  [ -n "$audience" ] && aq="?audience=$audience"

  # `--set-base <url>` pins the origin every published link is built from.
  #
  # This exists because Tailscale Funnel's :8443 is blocked outbound on many
  # real networks, so a discovered funnel url yields links that work for you and
  # fail for whoever you send them to. Point this at a tunnel on standard :443
  # (or a permanent domain) and every surface — publish output, `--list`, the
  # Hosted UI — follows. A permanent domain is better set once in the daemon's
  # MUXPAD_PUBLIC_BASE_URL, which outranks this pin.
  if [ -n "$set_base" ]; then
    local res
    res="$(http_request PUT /api/publish/base "{\"url\":$(json_string "$set_base")}")"
    if [ "$JSON_OUTPUT" = "1" ]; then printf '%s\n' "$res"; return; fi
    printf '%s✓%s public base is now %s\n' "$C_GREEN" "$C_RESET" \
      "$(printf '%s' "$res" | jq -r '.url')"
    local w
    w="$(printf '%s' "$res" | jq -r '.warning // empty')"
    [ -n "$w" ] && printf '%smuxpad: %s%s\n' "$C_DIM" "$w" "$C_RESET" >&2
    return
  fi

  if [ "$mode" = "clear-base" ]; then
    local res
    res="$(http_request DELETE /api/publish/base)"
    printf '%s✓%s pin cleared; base is now %s\n' "$C_GREEN" "$C_RESET" \
      "$(printf '%s' "$res" | jq -r '.url // "(none — links are local-only)"')"
    return
  fi

  # `--base` shows what every link is being built from, and why.
  if [ "$mode" = "base" ]; then
    local res
    res="$(http_request GET "/api/publish/base$aq")"
    if [ "$JSON_OUTPUT" = "1" ]; then printf '%s\n' "$res"; return; fi
    printf '%s' "$res" | jq -r '
      "  base:      \(.url // "(none — links would be local-only)")",
      "  from:      \(.source)",
      "  for:       \(.audience // "tailnet" | if . == "public" then "anyone (--public)" else "your own devices — the default" end)",
      "  keeps:     \(
         if .durability == "ephemeral" then "NO — dies at the next tunnel restart"
         elif .durability == "tailnet" then "yes, forever — but only on your tailnet"
         elif .durability == "local"   then "no — loopback, never shareable"
         elif .durability == "permanent" then "yes"
         # An older daemon that predates this field. "yes" would be the one
         # answer that is unsafe to guess, since the whole point is that an
         # ephemeral base looks exactly like a permanent one.
         else "unknown (daemon predates this field)" end)",
      "  reachable: \(if .reachable == null then "not checked" else .reachable end)"
    '
    local n
    n="$(printf '%s' "$res" | jq -r '.note // empty')"
    [ -n "$n" ] && printf '  %snote:      %s%s\n' "$C_DIM" "$n" "$C_RESET"
    local w
    w="$(printf '%s' "$res" | jq -r '.warning // empty')"
    [ -n "$w" ] && printf '  %swarning:   %s%s\n' "$C_DIM" "$w" "$C_RESET"
    printf '  %scandidates (highest first):%s\n' "$C_DIM" "$C_RESET"
    printf '%s' "$res" | jq -r '.candidates[] | "    \(.source)\t\(.durability // "?")\t\(.url)"'
    return
  fi

  # `--url <slug-or-dead-link>` — the recovery verb. See the flag parser above.
  if [ "$mode" = "url" ]; then
    # Accept a whole URL and keep only its first path segment; a bare slug falls
    # through both substitutions unchanged. Also tolerates a `@N` version suffix
    # so a link to `/report@2/` resolves back to `report`.
    local slug="$want_url"
    slug="${slug#*://}"          # drop scheme
    case "$slug" in */*) slug="${slug#*/}" ;; *) slug='' ;; esac
    [ -z "$slug" ] && slug="$want_url"
    slug="${slug%%/*}"           # first path segment only
    slug="${slug%%\?*}"          # …without a query
    local res found
    res="$(http_request GET "/api/publish$aq")"
    found="$(printf '%s' "$res" | jq -r --arg s "${slug%%@*}" \
      '(.publishes[]? | select(.slug == $s) | .url) // empty')"
    if [ -z "$found" ] || [ "$found" = "null" ]; then
      printf 'muxpad publish: no artifact named %s — `muxpad publish --list` shows what is here\n' \
        "${slug%%@*}" >&2
      exit 1
    fi
    # A version suffix survives the round trip: `--url .../report@2/` answers
    # with the CURRENT link to that same version, not to the live one.
    case "$slug" in
      *@*) printf '%s\n' "${found%/"${slug%%@*}"/}/${slug}/" ;;
      *) printf '%s\n' "$found" ;;
    esac
    # The recovery verb now says what it just handed over. stdout stays JUST the
    # url — `$(muxpad publish --url x)` has to keep working — so the caveat goes
    # to stderr, which is where the publish path already puts it. This matters
    # most for `--public`: the note is how you learn that the link you asked to
    # be sendable is not one.
    base_note_line "$(printf '%s' "$res" | jq -c '.base // empty')"
    return 0
  fi

  if [ "$mode" = "list" ]; then
    local res
    res="$(http_request GET "/api/publish$aq")"
    if [ "$JSON_OUTPUT" = "1" ]; then
      printf '%s\n' "$res"
      return
    fi
    # The URL column is the point of the listing, not decoration: when a
    # quick-tunnel hostname rotates, every link the user is holding is dead and
    # this table is where the live ones are. It was printing everything about an
    # artifact EXCEPT how to open it.
    print_table "$(printf '%s' "$res" | jq '.publishes')" \
      'SLUG:.slug' \
      'FILES:(.files | tostring)' \
      'VERS:((.versions // []) | length | tostring)' \
      'CREATED:(.created / 1000 | strflocaltime("%Y-%m-%d %H:%M"))' \
      'URL:(.url // "—")'
    base_note_line "$(printf '%s' "$res" | jq -c '.base')"
    return
  fi

  if [ -n "$FLAG_rm" ]; then
    http_request DELETE "/api/publish/$FLAG_rm" >/dev/null
    echo "removed $FLAG_rm"
    return
  fi

  # `--update <slug>` is `--name` with the create path CLOSED: the slug must
  # already exist. That is the whole point — `--name` creates-or-replaces, so a
  # typo quietly mints a NEW artifact (this is how six near-identical
  # `acme-creative*` slugs came to exist instead of six versions of one), while
  # --update turns the same typo into a readable 404.
  local update_slug="${FLAG_update:-}"
  if [ -n "$update_slug" ] && [ -n "$FLAG_name" ] && [ "$update_slug" != "$FLAG_name" ]; then
    echo 'muxpad publish: --update and --name disagree; pass just one' >&2
    exit 1
  fi

  local src="${POSITIONAL[0]:-}"
  if [ -z "$src" ]; then
    echo 'usage: muxpad publish <file-or-dir> [--name=slug | --update=slug] | --list | --url <slug> | --rm <slug>' >&2
    exit 1
  fi
  # The server requires an absolute path — resolve relative ones here.
  case "$src" in
    /*) ;;
    *) src="$PWD/$src" ;;
  esac
  local body base_url slug
  base_url="$(publish_base_url)"
  slug="${update_slug:-$FLAG_name}"
  body="{\"path\":$(json_string "$src")"
  [ -n "$slug" ] && body="$body,\"name\":$(json_string "$slug")"
  [ -n "$update_slug" ] && body="$body,\"update\":true"
  [ -n "$base_url" ] && body="$body,\"public_base_url\":$(json_string "$base_url")"
  # Sent only when asked for. An absent field means the server's default, which
  # is the durable base — so an older CLI, a script, and the Hosted view all get
  # the link that still works tomorrow without knowing this field exists.
  [ -n "$audience" ] && body="$body,\"audience\":$(json_string "$audience")"
  body="$body}"
  local res
  res="$(http_request POST /api/publish "$body")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
    return
  fi
  local warning
  warning="$(printf '%s' "$res" | jq -r '.warning // empty')"
  [ -n "$warning" ] && printf '%smuxpad: %s%s\n' "$C_DIM" "$warning" "$C_RESET" >&2
  # The shelf life of the link about to be printed. This is the moment it
  # matters: the user is about to paste it somewhere permanent.
  base_note_line "$(printf '%s' "$res" | jq -c '.base // empty')"
  # stdout is JUST the URL — script-friendly.
  printf '%s' "$res" | jq -r '.url'
}

# ─── muxpad app — registered local web servers ───────────────────────────────
#
# An APP is a long-running local web server muxpad supervises WITHOUT it
# occupying a tab. Under the hood it is a `muxpad serve` pane in a hidden
# workspace: ptyd owns the process (so it survives a main-server restart), the
# serve wrapper restarts a crashing command, and the serve supervisor rebuilds
# the pty after a ptyd restart.
#
# `muxpad app` and `muxpad publish` are deliberately SEPARATE verbs. An app is a
# private process; an artifact is public bytes. They share the Hosted view, not
# a primitive.

cmd_app_add() {
  # Bare mode flags are pre-stripped: parse_flags treats `--foo` (no '=') as
  # taking the NEXT argument as its value, and `FLAG_no-start` is not a legal
  # shell variable name anyway. Same shape as `cron new`.
  local rest=() start_flag='' autostart_flag='' a
  for a in "$@"; do
    case "$a" in
      --no-start) start_flag=false ;;
      --no-autostart) autostart_flag=false ;;
      *) rest+=("$a") ;;
    esac
  done
  reset_flags name cwd url slug
  parse_flags name cwd url slug -- "${rest[@]+"${rest[@]}"}"
  local url="${FLAG_url:-}"
  # Everything after the flags (or after a bare --) is the command, verbatim.
  local cmdv=("${POSITIONAL[@]:-}")
  if [ -z "$url" ] || [ "${#POSITIONAL[@]}" -lt 1 ]; then
    cat >&2 <<'USAGE'
usage: muxpad app add --url=<url> [--name=<name>] [--slug=<slug>] [--cwd=<dir>]
                      [--no-start] [--no-autostart] -- <command...>

  e.g. muxpad app add --name=Notes --url=https://host.ts.net:4322 \
         --cwd=~/notes -- ./start
USAGE
    exit 1
  fi
  local cwd="${FLAG_cwd:-$PWD}"
  # `--cwd=~/notes` does NOT tilde-expand: neither bash nor zsh expands `~`
  # after an `=` in a non-assignment word, so the shell hands us the literal
  # string and the naive relative-path branch below would turn it into
  # `$PWD/~/notes`, which the server rejects as "no such directory". Expand a
  # leading `~/` ourselves — it is the form every example uses.
  case "$cwd" in
    '~') cwd="$HOME" ;;
    '~/'*) cwd="$HOME/${cwd#'~/'}" ;;
  esac
  case "$cwd" in
    /*) ;;
    *) cwd="$PWD/$cwd" ;;
  esac
  local name="${FLAG_name:-$(basename "$cwd")}"
  # Re-join the command into ONE line, which is what the server stores and the
  # pane's shell runs. Each word is re-quoted with %q: the words arrived here
  # already split by the caller's shell, so pasting them back together raw
  # would silently destroy the original quoting —
  #   `-- node app.js --msg "hello world"`  became  `node app.js --msg hello world`
  # and anything containing a space, `;`, `$` or `*` was re-interpreted inside
  # the pane. %q is the only way to rebuild a line that means what was typed.
  local command_str=''
  local a
  for a in "${cmdv[@]}"; do
    [ -n "$command_str" ] && command_str+=' '
    command_str+="$(printf '%q' "$a")"
  done

  local body
  body="{\"name\":$(json_string "$name"),\"cwd\":$(json_string "$cwd")"
  body="$body,\"command\":$(json_string "$command_str"),\"url\":$(json_string "$url")"
  [ -n "$FLAG_slug" ] && body="$body,\"slug\":$(json_string "$FLAG_slug")"
  [ -n "$start_flag" ] && body="$body,\"start\":false"
  [ -n "$autostart_flag" ] && body="$body,\"autostart\":false"
  body="$body}"

  local res
  res="$(http_request POST /api/apps "$body")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
    return
  fi
  printf '%s✓%s app registered\n' "$C_GREEN" "$C_RESET"
  printf '  %sslug:%s   %s\n' "$C_DIM" "$C_RESET" "$(printf '%s' "$res" | jq -r '.slug')"
  printf '  %sstate:%s  %s\n' "$C_DIM" "$C_RESET" "$(printf '%s' "$res" | jq -r '.state')"
  printf '  %surl:%s    %s\n' "$C_DIM" "$C_RESET" "$(printf '%s' "$res" | jq -r '.url')"
}

cmd_app_list() {
  local res
  res="$(http_request GET /api/apps)"
  # WHY carries the url-health reason, but ONLY where it is a diagnosis. For a
  # stopped app nothing is supposed to answer, so echoing "unreachable" there
  # reads as a fault the user just caused on purpose; for a running one the
  # reason is "ok", which is noise beside STATE.
  print_table "$(printf '%s' "$res" | jq '.apps')" \
    'SLUG:.slug' \
    'STATE:.state' \
    'URL:.url' \
    'WHY:(if (.state == "stopped" or .state == "running") then "-" else (.health.reason // "-") end)' \
    'CWD:.cwd' \
    'NAME:.name'
}

cmd_app_show() {
  local ref="${1:-}"
  if [ -z "$ref" ]; then
    echo 'usage: muxpad app show <slug|id>' >&2
    exit 1
  fi
  local res
  res="$(http_request GET "/api/apps/$ref")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
    return
  fi
  printf '%s\n' "$res" | jq -r '
    "  slug:      \(.slug)",
    "  name:      \(.name)",
    "  state:     \(.state)",
    "  url:       \(.url)",
    "  cwd:       \(.cwd)",
    "  command:   \(.command)",
    "  autostart: \(.autostart)",
    "  pty:       \(if .pty == null then "unknown (ptyd unreachable)" else .pty end)",
    "  health:    \(if .health == null then "not probed" else "\(.health.reason) \(.health.status // "")" end)",
    "  pane:      \(.pane_id // "-")"
  '
}

# start | stop share a shape: POST /api/apps/<ref>/<verb>, print the new state.
app_lifecycle() {
  local verb="$1" ref="${2:-}"
  if [ -z "$ref" ]; then
    echo "usage: muxpad app $verb <slug|id>" >&2
    exit 1
  fi
  local res
  res="$(http_request POST "/api/apps/$ref/$verb")"
  if [ "$JSON_OUTPUT" = "1" ]; then
    printf '%s\n' "$res"
    return
  fi
  printf '%s✓%s %s → %s\n' "$C_GREEN" "$C_RESET" \
    "$(printf '%s' "$res" | jq -r '.slug')" "$(printf '%s' "$res" | jq -r '.state')"
}

cmd_app_rm() {
  local ref="${1:-}"
  if [ -z "$ref" ]; then
    echo 'usage: muxpad app rm <slug|id>' >&2
    exit 1
  fi
  http_request DELETE "/api/apps/$ref" >/dev/null
  printf '%s✓%s app %s removed\n' "$C_GREEN" "$C_RESET" "$ref"
}

# `app logs` prints the app's pane scrollback — the app IS a pane, so its logs
# are that pane's terminal. Reuses `pane read` rather than growing a second
# scrollback path.
cmd_app_logs() {
  # `--raw` is bare — pre-strip it (see cmd_app_add).
  local rest=() raw='' a
  for a in "$@"; do
    case "$a" in
      --raw) raw=1 ;;
      *) rest+=("$a") ;;
    esac
  done
  reset_flags lines
  parse_flags lines -- "${rest[@]+"${rest[@]}"}"
  local ref="${POSITIONAL[0]:-}"
  if [ -z "$ref" ]; then
    echo 'usage: muxpad app logs <slug|id> [--lines=N] [--raw]' >&2
    exit 1
  fi
  local pane
  pane="$(http_request GET "/api/apps/$ref" | jq -r '.pane_id // empty')"
  if [ -z "$pane" ]; then
    echo "muxpad: $ref is not running — no logs (start it first)" >&2
    exit 1
  fi
  local args=("$pane")
  [ -n "$FLAG_lines" ] && args+=("--lines=$FLAG_lines")
  [ -n "$raw" ] && args+=(--raw)
  cmd_pane_read "${args[@]}"
}

cmd_app() {
  require_jq
  case "${1:-}" in
    add|new) shift; cmd_app_add "$@" ;;
    list|ls) shift; cmd_app_list "$@" ;;
    show) shift; cmd_app_show "$@" ;;
    start) shift; app_lifecycle start "${1:-}" ;;
    stop) shift; app_lifecycle stop "${1:-}" ;;
    restart) shift; app_lifecycle stop "${1:-}" >/dev/null; app_lifecycle start "${1:-}" ;;
    logs) shift; cmd_app_logs "$@" ;;
    rm|delete) shift; cmd_app_rm "$@" ;;
    *)
      cat >&2 <<'USAGE'
usage: muxpad app <command>

  add      register a local web server muxpad keeps running, with NO tab
  list     every app: slug, state, url, why-not-reachable, cwd, name
  show     one app in full, including the measured pty + health signals
  start    bring it up (and keep it up)
  stop     take it down and leave it down
  restart  stop then start
  logs     the app's pane scrollback — an app IS a pane underneath
  rm       unregister it and take it down

`muxpad publish` is the other verb: static bytes at a PUBLIC url. An app is a
private process; they share the Hosted view, not a primitive.
USAGE
      exit 1
      ;;
  esac
}

# Internal: SessionStart hook target installed by `muxpad claude`. Reads the
# hook payload JSON on stdin, extracts session_id, and reports it to the
# daemon for the current pane. Always exits 0 — it runs inside a live Claude
# session and must never break it.
cmd_agent_hook() {
  local payload sid
  payload="$(cat)"
  sid="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)"
  if [ -n "$sid" ] && [ -n "${MUXPAD_PANE_ID:-}" ] && [ -n "${MUXPAD_API_URL:-}" ]; then
    local body
    body="{\"pane_id\":$(json_string "$MUXPAD_PANE_ID"),\"session_id\":$(json_string "$sid"),\"source\":\"SessionStart\"}"
    # Subshell so http_request's exit-on-non-2xx can never fail the hook (it
    # runs inside a live Claude session); we always want to exit 0 below.
    ( http_request POST /api/agent-sessions/hook "$body" ) >/dev/null 2>&1 || true
  fi
  exit 0
}

usage() {
  cat <<'USAGE' >&2
muxpad — a personal multi-workspace terminal-and-browser mosaic.

structure:
  workspace   top-level container, has many tabs
  tab         single mosaic, has many panes laid out as splits
  pane        a shell PTY (kind=shell) or an iframe URL (kind=url)

env (set automatically inside a muxpad pane):
  MUXPAD_BIN              path to this CLI — its presence means you're in a pane
  MUXPAD_API_URL          daemon base URL (HTTP)
  MUXPAD_PANE_ID          current pane id
  MUXPAD_TAB_ID           current tab id          (default for --tab)
  MUXPAD_WORKSPACE_ID     current workspace id    (default for --workspace)

All `new` commands print the created resource on stdout; chain by reading
the printed `id` (or use `--json | jq -r .id`).

daemon control:
  start                              build (if needed) and start ptyd + main server
  stop [--all]                       stop main server (and ptyd with --all)
  restart [--all]                    restart main server (and ptyd with --all)
  status                             show running state of both processes
  logs [--ptyd|--all]                tail server log (or ptyd / both)

HTTP CLI (requires the daemon; defaults read from MUXPAD_*_ID env):
  workspace new [--name=<name>]
  workspace list                              id, status, agents, tab count, name
  workspace delete <id>

  tab new       [--workspace=<id>] [--name=<name>] [--bootstrap=shell|agent] [--cwd=<dir>]
  tab list      [--workspace=<id>]            id, pin, status, agents, name
  tab delete    <id>

  pane new      [--tab=<id>] [--cmd=<cmd>] [--cwd=<cwd>] [--name=<name>]
                [--direction=right|left|above|below] [--target=<id>]
                                              shell pane. Placement is
                                              spatial: direction defaults to
                                              `right`; target defaults to
                                              the calling pane (MUXPAD_PANE_ID)
                                              or — outside a pane — appends
                                              at the root.
  pane open     [--tab=<id>] [--direction=…] [--target=<id>] <url>
                                              iframe pane, same placement rules
  pane list     [--tab=<id>] | --all          --all: every pane across all
                                              workspaces, one line each:
                                              <id> <ws>/<tab> <face> <status> <title>
  pane read     [<id>] [--lines=N] [--raw]    print a terminal pane's scrollback,
                                              ANSI-stripped (grep-able); --raw
                                              keeps escapes, --lines trims to the
                                              last N lines. id defaults to
                                              MUXPAD_PANE_ID.
  pane send     <id> "text" [--no-enter]      type into a terminal pane's live
                                              pty; appends Enter unless
                                              --no-enter. Refused if the pane
                                              has no running pty. Use `--` before
                                              text that starts with a dash.
  pane send     <id> --key=<name> [...]       send named keys instead of text
                                              (repeatable): enter esc tab up
                                              down left right ctrl-a…ctrl-z
                                              e.g. --key=ctrl-c
  pane summarize [<id>]                       1–2 sentence deliverable summary
                                              of an agent pane's conversation
  pane delete   <id>
  pane rename   [<id>] <name>                 id defaults to MUXPAD_PANE_ID

  watch [--types=a,b]                stream the daemon's event bus to stdout,
                                     one event per line, until killed —
                                     pane/tab/workspace changes plus
                                     agent_turn start/done/fatal. --types
                                     filters (e.g. --types=agent_turn);
                                     --json prints raw MuxpadEvent JSON.

  open <url>                         open <url> in a new real browser tab
                                     (like macOS `open` / Linux `xdg-open`).
                                     The web UI surfaces a click-to-open toast
                                     so the popup isn't blocked. For an iframe
                                     pane in the mosaic, use `pane open` above.

  serve [--url=<url>] [--label=<text>] -- <command...>
                                     run a local web server in THIS pane under
                                     muxpad supervision: auto-restart on crash
                                     (with backoff; Ctrl-C stops for real) and
                                     the pane flips to the app's web view,
                                     with Terminal always in the face menu.
                                     e.g. muxpad serve --url=http://host:4321 \
                                            --label=Notes -- ./start

  tunnel setup <hostname> [--name=muxpad] [--relogin]
                                     make published links PERMANENT and PUBLIC,
                                     in one command: checks the zone is on
                                     Cloudflare, logs in (browser, once —
                                     skipped if already done), creates a named
                                     tunnel, routes the CNAME and tells muxpad.
                                     e.g. `muxpad tunnel setup pub.example.com`
                                     — ANY hostname in ANY zone on your
                                     Cloudflare account. $0/yr. If the zone is
                                     not on Cloudflare it says exactly what to
                                     do instead of failing at the CNAME.
                                     --relogin re-authorises, which a hostname
                                     in a second zone needs. No plist and no
                                     restart: the server re-reads the config on
                                     the next publish.
  tunnel --port <public port>        run the tunnel that puts published
                                     artifacts on the internet, and re-pin
                                     muxpad's public base. Uses the NAMED tunnel
                                     when `tunnel setup` has been run (one fixed
                                     hostname, forever); otherwise a QUICK
                                     tunnel, whose four-word hostname Cloudflare
                                     reassigns on every restart, killing every
                                     link built from it. Started for you as the
                                     `tunnel` app on the first publish —
                                     `muxpad app logs tunnel` to watch it,
                                     `muxpad app stop tunnel` to close the door.

  app-url <url> [--label=<text>]     declare the web app THIS pane serves.
                                     The pane chrome then offers a "switch to
                                     web view" of it. Run from your dev script
                                     once the server is listening, e.g.
                                     `muxpad app-url http://localhost:5173 --label Web`.

  agent [--resume <sid>]             run a persistent chat-native Claude session
                                     in THIS pane: drive it from the pane's web
                                     chat face; the terminal shows an activity
                                     log. Auto-resumes across ptyd restarts via
                                     the pane's saved startup command.
  agent new [--workspace=<id>] [--cwd=<dir>] [--name=<tab name>] [--backend=<b>]
            [--model=<model>] [--mode=chat|agent] "message"
                                     create an agent tab, send the first
                                     message so it starts working immediately,
                                     and print the tab's URL. cwd defaults to
                                     $PWD; workspace to MUXPAD_WORKSPACE_ID.
                                     --name labels the tab (skips AI auto-
                                     rename); --model pins the session model
                                     (e.g. 'claude-opus-4-8[1m]'); --mode
                                     picks Chat mode (muxpad's assistant —
                                     decisive, terse, result-first; the
                                     default) or Agent mode (the harness as
                                     it ships, no muxpad contract).
  agent list                         every tracked agent session (pane id,
                                     backend, mode, TURN, view, session id).
                                     TURN is the session's running|idle turn
                                     state — NOT the five-state pane/tab
                                     `status` the list commands above print.
  agent respawn <paneId> | --all [--backend=<id>]
                                     re-exec a pane's agent runner in place.
                                     startup_cmd carries --resume <sid>, so the
                                     conversation comes back from its transcript
                                     and ptyd is never touched (no terminal
                                     dies). --all covers every tracked agent
                                     session; --backend narrows it to one
                                     harness. Per-pane result, exit 1 if any
                                     failed.
  agent send <paneId> "message"      deliver a message to a pane's agent via
                                     the server queue. exit 0 = sent/queued
                                     (queued noted on stderr), 1 = rejected
                                     (reason printed).
  agent transcript <paneId> [--tail=N]
                                     last N normalized transcript events as
                                     JSONL (role, text, tool-use summaries) —
                                     same shape for every backend.
  agent wait <paneId> [--timeout=SEC]
                                     block until that pane's agent finishes
                                     its turn (run in the background to wait
                                     tokenlessly). Keyed on real turn state,
                                     not pty output. exit 0 = done or already
                                     idle, 1 = not an agent pane, 2 = agent
                                     fatal, 3 = timeout.
  cron new --name=<n> --at='<schedule>' (--pane[=<id|name>] | --new-tab)
           [--tz=<IANA>] [--cwd=<dir>] [--model=<m>] [--backend=<b>]
           [--mode=chat|agent] [--catchup=once|skip|all] [--overlap=skip|queue]
           [--on-context=fire|compact-first|rotate|skip] [--quiet=<mins>]
           [--max-open=<n>] [--no-close] "prompt"
                                     a DURABLE schedule owned by muxpad, not by
                                     an agent session: survives restarts,
                                     catches up after downtime, never expires,
                                     visible and editable from anywhere.
                                     --at takes a cron expression ('0 9 * * 1-5')
                                     or a phrase ('daily at 09:00', 'weekdays
                                     at 09:00', 'every 30m'). --pane with no
                                     value = THIS pane. --new-tab spawns a
                                     fresh agent tab per fire (clean context)
                                     and closes it when the run finishes.
  cron list                          name, schedule, target, next due, last run,
                                     last status, failure streak
  cron show <id|name>                one schedule in full + its run history
  cron run <id|name>                 fire it NOW — test before you trust it
  cron pause|resume <id|name>        stop/start firing (resume re-anchors, so a
                                     long pause doesn't replay)
  cron rm <id|name>                  delete it
  app add --url=<url> [--name=<n>] [--slug=<s>] [--cwd=<dir>]
          [--no-start] [--no-autostart] -- <command...>
                                     register a local web server muxpad keeps
                                     running WITHOUT it occupying a tab. It runs
                                     as a supervised pane in a hidden workspace:
                                     ptyd owns the process (survives a server
                                     restart), the command is restarted on
                                     crash, and the pty is rebuilt after a ptyd
                                     restart. Private — tailnet only.
                                     e.g. muxpad app add --name=Notes \
                                            --url=https://host.ts.net:4322 \
                                            --cwd=~/notes -- ./start
  app list                           slug, state, url, why-not-reachable, cwd.
                                     state is MEASURED: starting | running |
                                     unreachable | stopped | gave up.
  app show <slug>                    one app in full, with the raw pty and
                                     health signals behind its state
  app start|stop|restart <slug>      stop leaves it down until you start it
  app logs <slug> [--lines=N] [--raw]
                                     the app's pane scrollback — an app IS a
                                     pane underneath
  app rm <slug>                      unregister and take it down

  publish <file-or-dir> [--name=slug]
                                     host a copy of the file/dir at a PUBLIC
                                     internet URL (Tailscale Funnel, no
                                     tailnet needed to view) and print that
                                     URL on stdout. A lone .html file becomes
                                     the slug's index page. --name pins the
                                     slug ([a-z0-9-]); republishing a named
                                     slug replaces it and rotates the previous
                                     copy to /<slug>@2/ (3 kept). Random slugs
                                     are unguessable (8 hex chars).
  publish --update=<slug> <file-or-dir>
                                     replace an EXISTING artifact. Unlike
                                     --name it refuses to create, so a typo is
                                     an error instead of a seventh near-
                                     identical slug. Run `publish --list` first
                                     and reuse the slug when updating the same
                                     thing.
  publish --list                     list published artifacts, with the CURRENT
                                     link for each (slug, files, versions,
                                     created, url)
  publish --url <slug-or-dead-link>  reprint a live link for something already
                                     published. The bytes outlive the address:
                                     when a quick tunnel restarts it is handed a
                                     new random hostname and every link given
                                     out under the old one goes dead, but the
                                     slug never moves. Paste the dead URL in
                                     whole — the slug is read out of its path.
                                     Answers with the PERMANENT tailnet link, so
                                     recovering a dead link twice is not a
                                     thing that happens; add --public for the
                                     sendable form.
  publish --rm <slug>                unpublish, versions included (the funnel
                                     stays up; run
                                     `tailscale funnel --https=8443 off` to
                                     close it entirely)
  publish --public                   ask for a link you can SEND to somebody.
                                     By default every published link uses your
                                     TAILNET address, which is permanent and
                                     works on all your own devices (phone
                                     included) but nowhere else. --public uses
                                     the Cloudflare tunnel instead — reachable
                                     by anyone, and its hostname is reassigned
                                     on every tunnel restart, so the link dies
                                     then. The caveat is printed to stderr
                                     either way. Combines with --list, --base
                                     and --url.
  publish --base                     show the origin every published link is
                                     built from, who it is for, whether it is
                                     answering, and the full candidate list
  publish --set-base=<https://…>     pin that origin. Tailscale Funnel's :8443
                                     is blocked outbound on many real networks,
                                     so a discovered funnel URL gives links that
                                     work for YOU and fail for whoever you send
                                     them to. Point this at a tunnel on standard
                                     :443 (or a permanent domain) and publish
                                     output, --list and the Hosted view all
                                     follow. A permanent domain is better set
                                     once as MUXPAD_PUBLIC_BASE_URL on the
                                     daemon, which outranks this pin.
  publish --clear-base               drop the pin and fall back to discovery
  search "query" [--limit=N] [--sid=SID] [--role=ROLE]
                                     full-text search across every archived
                                     agent session (FTS5 query syntax; falls
                                     back to a phrase match on bad syntax)
  search --sessions [--cwd=X] [--limit=N]
                                     list archived sessions (sid, backend,
                                     pane, cwd, last activity)
  claude [claude args...]            launch Claude Code in THIS pane as a
                                     muxpad-tracked session so it can be viewed
                                     and driven from the web chat (and switched
                                     between terminal and chat). Passes your
                                     args straight through to the real `claude`;
                                     just adds session tracking. e.g.
                                     `muxpad claude --dangerously-skip-permissions`.

global flags:
  --json                             emit raw JSON instead of pretty output
                                     (place BEFORE the subcommand)

examples:
  muxpad pane new --cmd='pnpm dev'                       # sibling to the right
  muxpad pane new --direction=below --cmd='tail -f log'  # below this pane
  muxpad pane open https://grafana.local                 # iframe to the right
  muxpad open https://grafana.local                      # real new browser tab
  muxpad --json workspace list | jq -r '.[].id'
  ws=$(muxpad --json workspace new --name=foo | jq -r .id) \
    && tab=$(muxpad --json tab new --workspace="$ws" | jq -r .id) \
    && p1=$(muxpad --json pane new --tab="$tab" --cmd='pnpm dev' | jq -r .id) \
    && muxpad pane new --tab="$tab" --target="$p1" --direction=below \
         --cmd='tail -f log'
USAGE
}

# Verbs that talk HTTP need jq and may need MUXPAD_API_URL. The daemon-
# control verbs (start/stop/…) don't, so we only enforce when routing
# into the HTTP branch.
needs_http() {
  case "$1" in
    workspace|tab|pane|open|watch|search|publish|app) return 0 ;;
    *) return 1 ;;
  esac
}

# Strip --json (top-level) before dispatching. Per-verb flags are
# parsed inside the verb handler. Populates the global ARGS array.
strip_global_flags "$@"

VERB="${ARGS[0]:-}"

if [ -n "$VERB" ] && needs_http "$VERB"; then
  require_jq
fi

case "$VERB" in
  start) cmd_start ;;
  stop) cmd_stop "${ARGS[@]:1}" ;;
  restart) cmd_restart "${ARGS[@]:1}" ;;
  status) cmd_status ;;
  logs) cmd_logs "${ARGS[@]:1}" ;;
  workspace) cmd_workspace "${ARGS[@]:1}" ;;
  tab) cmd_tab "${ARGS[@]:1}" ;;
  pane) cmd_pane "${ARGS[@]:1}" ;;
  open) cmd_open "${ARGS[@]:1}" ;;
  watch) cmd_watch "${ARGS[@]:1}" ;;
  app-url) cmd_app_url "${ARGS[@]:1}" ;;
  app) cmd_app "${ARGS[@]:1}" ;;
  serve) cmd_serve "${ARGS[@]:1}" ;;
  tunnel) cmd_tunnel "${ARGS[@]:1}" ;;
  claude) cmd_claude "${ARGS[@]:1}" ;;
  agent) cmd_agent "${ARGS[@]:1}" ;;
  cron) cmd_cron "${ARGS[@]:1}" ;;
  search) cmd_search "${ARGS[@]:1}" ;;
  publish) cmd_publish "${ARGS[@]:1}" ;;
  _agent-hook) cmd_agent_hook ;;
  # Internal: print which tailscale binary this script would use, or nothing.
  # The only seam onto find_tailscale, so tailscale-bin.test.ts can check the
  # shell and TypeScript resolvers still agree — and it answers "why is muxpad
  # touching the Tailscale app?" without a stack trace.
  _tailscale-bin) find_tailscale ;;
  # Internal: print the public-base hint this shell would send with a publish,
  # or nothing. The only seam onto publish_base_url — otherwise it is reachable
  # only by doing a real publish, and the property that matters most about it is
  # what it does when things FAIL (see tailscale-bin.test.ts).
  _publish-base-url) publish_base_url ;;
  # Internal: print the base URL this shell would put in a human-clickable link.
  # Same reason as the two above — it asks the server over curl under `set -e`,
  # and `muxpad agent new` calls it only after the tab exists, so its behaviour
  # on a dead or slow server is the thing worth pinning.
  _printable-base) printable_base ;;
  # Internal: print this machine's tailnet FQDN, worked out with no exec at all.
  # Also the honest answer to "does muxpad still need the Tailscale binary?" —
  # if this prints a name, it does not.
  _tailnet-hostname) tailnet_hostname ;;
  ''|help|-h|--help) usage; [ "$VERB" = '' ] && exit 1 || exit 0 ;;
  *)
    echo "muxpad: unknown command '$VERB'" >&2
    usage
    exit 1
    ;;
esac
