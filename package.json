{
  "name": "muxpad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm -r --parallel dev",
    "serve": "./scripts/muxpad start",
    "serve:public": "MUXPAD_TAILSCALE_SERVE=1 ./scripts/muxpad start",
    "serve:stop": "./scripts/muxpad stop",
    "serve:restart": "./scripts/muxpad restart",
    "serve:status": "./scripts/muxpad status",
    "serve:logs": "./scripts/muxpad logs",
    "postinstall": "find node_modules -path '*/node-pty/prebuilds/*/spawn-helper' -exec chmod +x {} + 2>/dev/null || true"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@biomejs/biome": "^1.9.4"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  }
}
